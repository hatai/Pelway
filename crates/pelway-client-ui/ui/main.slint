// Pelway デスクトップクライアントの画面の骨組み（段階A）。
//
// この回では slint への依存を足さないため、このファイルは未コンパイル・未検証。
// 段階B（別指示）で依存に足してコンパイルする。
// 部品の並びはデスクトップのモック（docs/ui-mocks/csv.html・csv_dark.html、
// 試作モック・暫定承認 11/8・最終承認は未）を参考にした「枠と並びだけ」:
// 左の列（rail）・上の帯・「今日」の画面・チャンネルの画面・右の枠（スレッド・AIの作業）・
// 下のメッセージ入力欄。モックにない部品・台本操作（場面 1/7・前へ・次へ）は置かない。
//
// 決まりごと:
// - 色は DesignTokens（下の global）のトークン名だけで参照し、色の値は書かない。
//   値もここには置かない（初期値なし）。Rust がトークンの正本 JSON
//   （tokens/pelway.tokens.json）から読んだ値をテーマごとに設定する。
// - 利用者に見える文言はここに書かず、Rust が Fluent（i18n/{ja,en}/main.ftl）から
//   引いた文字列を tr-* プロパティで受け取る。Slint の @tr()（gettext）は使わない
//   （仕様が Fluent のため）。
// - テーマ名（light / dark / light-high-contrast / dark-high-contrast）の定義元は
//   Rust の Theme enum（src/theme.rs）。ThemeState.current-name は Rust から渡される。
// - 読み上げ・キーボード操作は AccessKit 経由の accessible-role / accessible-label
//   と、押せる部品の FocusScope で付ける（Issue 379）。読み上げ枠は足さない。
//   承認・決定のボタンの Enter/Space は callback で中核の input::on_key に渡し、
//   キーの意味づけを UI 側で書き直さない。NVDA・VoiceOver・Orca での確認は未検証。

// Slint の attribution widget（About ダイアログの中で使う。Issue 237）。
import { AboutSlint } from "std-widgets.slint";

// デザイントークン。名前だけ。テーマごとの値は Rust 側から設定する
// （out のグローバルは Rust から値を渡せないため in-out にする。初期値は置かない）。
export global DesignTokens {
    // 面と文字
    in-out property <brush> bg;
    in-out property <brush> tile;
    in-out property <brush> well;
    in-out property <brush> ink;
    in-out property <brush> sub;
    in-out property <brush> mute;
    in-out property <brush> line;
    // 強調
    in-out property <brush> acc;
    in-out property <brush> acc-fill;
    in-out property <brush> acc-fill-hover;
    in-out property <brush> acc-fill-pressed;
    in-out property <brush> acc-wash;
    in-out property <brush> on-acc;
    // 主ボタン
    in-out property <brush> primary-bg;
    in-out property <brush> primary-fg;
    in-out property <brush> primary-bg-hover;
    in-out property <brush> primary-bg-pressed;
    // アバター
    in-out property <brush> avatar-human-bg;
    in-out property <brush> avatar-human-fg;
    in-out property <brush> avatar-ai-bg;
    in-out property <brush> avatar-ai-fg;
    in-out property <brush> ai-badge-bg;
    in-out property <brush> ai-badge-fg;
    // 状態
    in-out property <brush> pending-bg;
    in-out property <brush> pending-bar;
    in-out property <brush> success-fg;
    in-out property <brush> success-bg;
    in-out property <brush> danger-fg;
    in-out property <brush> danger-bg;
    in-out property <brush> warning-fg;
    in-out property <brush> warning-bg;
    in-out property <brush> unread;
    in-out property <brush> private-bg;
    // 社外送信カード
    in-out property <brush> ext-bg;
    in-out property <brush> ext-fg;
    in-out property <brush> ext-label;
    in-out property <brush> ext-meta;
    in-out property <brush> ext-address;
    in-out property <brush> ext-link;
    in-out property <brush> ext-body-bg;
    in-out property <brush> ext-body-fg;
    in-out property <brush> ext-go-bg;
    in-out property <brush> ext-go-fg;
    in-out property <brush> ext-fx-fg;
    in-out property <brush> ext-fx-line;
    in-out property <brush> ext-divider;
    // その他
    in-out property <brush> focus-ring;
    in-out property <brush> link;
    in-out property <brush> selected-wash;
    in-out property <brush> border-form;
}

// 現在のテーマ。安定名の定義元は Rust の Theme enum（src/theme.rs）。
// テーマを切り替える画面は作らない。
export global ThemeState {
    // Rust（Theme::name()）から受け取る。out だと Rust から値を渡せない
    // （setter が空のスタブになる）ため in-out にする（第9枠に記録）。
    in-out property <string> current-name;
}

// 読み上げ用の種別の呼び名（Issue 379）。文言は Rust が Fluent から引いて
// tr-* と同じ約束で渡す。どの部品からも読めるよう global に置く。
export global A11yStrings {
    in-out property <string> tr-ai-bot-label;
    in-out property <string> tr-person-label;
}

// 決定・承認ボタンのキー操作（Issue 379）。生のキー（KeyEvent.text・Ctrl/Cmd・
// Shift）を受け取り、Rust 側が中核の input::on_key に渡して「決定・承認に
// なるか」を決める（意味づけを .slint 側で書き直さない。戻り値はキーを
// 消費したか）。階層の転送を避けるため global に置く。
export global KeyRouter {
    callback decide-key(string, string, int, string, bool, bool) -> bool;
    callback send-key(string, bool, bool) -> bool;
}

// ---- 小さい部品 ----

// アバター。人は円、AI は四角（AI であることはバッジでも示す）。
// a11y-label は呼び出し側が「表示名＋種別（AI Bot・人）」を組み立てて渡す（Issue 379）。
component AvatarView inherits Rectangle {
    in property <bool> is-ai: false;
    in property <string> initial;
    in property <string> a11y-label;
    width: 34px;
    height: 34px;
    border-radius: self.is-ai ? 10px : 17px;
    background: self.is-ai ? DesignTokens.avatar-ai-bg : DesignTokens.avatar-human-bg;
    accessible-role: image;
    accessible-label: root.a11y-label;
    Text {
        text: root.initial;
        color: root.is-ai ? DesignTokens.avatar-ai-fg : DesignTokens.avatar-human-fg;
        font-size: 13px;
        font-weight: 600;
        // 頭文字は読み上げに出さない（種別付きの名前はアバターのラベルが担う）。
        accessible-role: none;
        accessible-label: "";
    }
}

// AI Botであることの印（「AI」）。
component AiBadgeView inherits Rectangle {
    in property <string> label;
    height: 14px;
    border-radius: 6px;
    background: DesignTokens.ai-badge-bg;
    // 注: padding は layout 要素にしか効かないため、中に HorizontalLayout を置く
    // （第9枠に記録。左右 4px の余白で「AI」の文字を置く）。
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.label;
            color: DesignTokens.ai-badge-fg;
            font-size: 10px;
            font-weight: 500;
            vertical-alignment: center;
            // 「AI」の文字だけが名前として二度読まれないよう読み上げから外す
            // （Issue 379。種別の呼び名は行・アバターのラベルが「AI Bot」と言う）。
            accessible-role: none;
            accessible-label: "";
        }
    }
}

// 常時表示の帯（S00。「デモ・模擬応答」の印と「AI」の印を全画面に出し続ける）。
// 消す操作・隠す設定は作らない（entry-points の画面契約 README §C）。
component DemoBannerView inherits Rectangle {
    in property <string> tr-banner-demo-mock;
    in property <string> tr-ai-badge;
    HorizontalLayout {
        spacing: 8px;
        // 「デモ・模擬応答」の印（caution 系 pill）。狭い幅では行を増やして
        // 折り返す。省略・三点リーダー・行の脱落はしない（行数の上限や
        // 省略用の overflow を付けず、文言は必ず全部出る）。
        Rectangle {
            border-radius: 8px;
            background: DesignTokens.warning-bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                Text {
                    text: root.tr-banner-demo-mock;
                    color: DesignTokens.warning-fg;
                    font-size: 11px;
                    font-weight: 500;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
        // 「AIであることの表示」（見える文字は「AI」。読み上げには載せない
        // —AiBadgeView の内側の文字は accessible-role: none）。
        AiBadgeView {
            horizontal-stretch: 0;
            label: root.tr-ai-badge;
        }
    }
}

// フォーカスが当たった部品の周りの枠。色は DesignTokens.focus-ring を参照する
// だけ（Issue 379。色の値は書かない）。
component FocusRing inherits Rectangle {
    border-width: 2px;
    border-color: DesignTokens.focus-ring;
    border-radius: 4px;
}

// 押せる部品（ボタン・行・リンク）。タップ/クリック・キーボード
// （Enter/Space）・支援技術の既定操作の 3 経路で activated を呼ぶ（Issue 379）。
// 承認・決定のボタンでは key-hit に中核の input::on_key を通る callback を
// 結び、Enter/Space の意味づけを UI 側で書き直さない。
component Pressable inherits Rectangle {
    // 読み上げの名前（呼び出し側が Fluent の文言を渡す）。
    in property <string> a11y-label;
    // マウス・タッチ・支援技術の既定操作。key-hit を結ばない部品では
    // キーボードの Enter/Space もここに来る。
    callback activated();
    // キー操作の横取り（KeyEvent.text・Ctrl/Cmd・Shift → 消費したか）。
    // 未結線なら既定の false が返り、下の汎用の Enter/Space 起動が動く。
    callback key-hit(string, bool, bool) -> bool;
    forward-focus: fs;
    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-action-default => { root.activated(); }
    @children
    ta := TouchArea {
        clicked => { root.activated(); }
    }
    fs := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if root.key-hit(event.text, event.modifiers.control || event.modifiers.meta, event.modifiers.shift) {
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus : FocusRing {
        border-radius: root.border-radius;
    }
}

// 左の列の1行（今日・チャンネル・DM）。押せるため Pressable（Issue 379）。
component RailRow inherits Pressable {
    in property <string> label;
    in property <bool> selected: false;
    callback pressed();
    height: 32px;
    border-radius: 12px;
    a11y-label: root.label;
    background: root.selected ? DesignTokens.selected-wash : DesignTokens.tile;
    activated => { root.pressed(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: root.selected ? DesignTokens.acc : DesignTokens.sub;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
}// 左の列の AI Botの行（名前＋在席状態。押せない一覧の項目として読み上げる）。
component RailAiRow inherits Rectangle {
    in property <string> label;
    in property <string> presence;
    in property <string> tr-ai-badge;
    height: 32px;
    border-radius: 12px;
    background: DesignTokens.tile;
    accessible-role: list-item;
    accessible-label: root.label + " " + A11yStrings.tr-ai-bot-label + " " + root.presence;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: root.label;
            color: DesignTokens.sub;
            font-size: 14px;
            vertical-alignment: center;
        }
        AiBadgeView {
            horizontal-stretch: 0;
            label: root.tr-ai-badge;
        }
        Text {
            text: root.presence;
            color: DesignTokens.mute;
            font-size: 10px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// 見出し（グループの小さいラベル）。
component GroupLabel inherits Text {
    color: DesignTokens.mute;
    font-size: 11px;
}

// リンクの書式の行。
component LinkText inherits Text {
    color: DesignTokens.link;
    font-size: 13px;
    // 注: Slint 1.18 の Text に underline のプロパティはないため下線は付かない
    // （第9枠に記録）。押されたことを外に伝える callback。
    callback touched();
    // Text だけでは押せないため、当たり判定は TouchArea で作る（Issue 331 で追加）。
    // 押せる部品として読み上げる（Issue 379。ラベルは text そのもの）。
    forward-focus: fs;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.touched(); }
    TouchArea {
        clicked => { root.touched(); }
    }
    fs := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.touched();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus : FocusRing {}
}

// ---- 判断待ち（Issue 331）のモデル ----

// 選択肢 1 つ（案A・案B など）。確定要求は option-id で選択を指す。
export struct DecisionOptionItem {
    option-id: string,
    body: string,
}

// 「自分の判断待ち」の 1 項目（依頼者・論点・待ち時間・対象チャネル・選択肢・
// 見ている版。判断待ちのコピーではなく元のチャットへのポインタ）。
export struct PendingItem {
    decision-id: string,
    version: int,
    requester: string,
    initial: string,
    is-ai: bool,
    channel: string,
    question: string,
    wait: string,
    options: [DecisionOptionItem],
}

// 「自分の依頼」の 1 項目（依頼の内容と進み具合。操作はしない）。
export struct RequestItem {
    meta: string,
    text: string,
    progress: string,
}

// ---- 左の列（rail） ----

component RailView inherits Rectangle {
    background: DesignTokens.tile;
    border-radius: 24px;
    // 文言（Rust から Fluent で引いて渡す）
    in property <string> tr-rail-viewing-as;
    in property <string> tr-rail-today;
    in property <string> tr-rail-channels;
    in property <string> tr-rail-dm-people;
    in property <string> tr-rail-dm-ai;
    in property <string> tr-ai-badge;
    // 合成データ
    in property <string> data-org-name;
    in property <string> data-channel-1;
    in property <string> data-channel-2;
    in property <string> data-channel-3;
    in property <string> data-channel-4;
    in property <bool> data-channel-2-selected: true;
    in property <string> data-person-1;
    in property <string> data-person-1-note;
    in property <string> data-person-2;
    in property <string> data-person-2-note;
    in property <string> data-ai-1;
    in property <string> data-ai-1-presence;
    in property <string> data-ai-2;
    in property <string> data-ai-2-presence;
    in property <string> data-ai-3;
    in property <string> data-ai-3-presence;
    callback today-pressed();
    VerticalLayout {
        padding: 20px;
        spacing: 2px;
        Text {
            text: root.data-org-name;
            color: DesignTokens.ink;
            font-size: 15px;
            font-weight: 600;
        }
        GroupLabel {
            text: root.tr-rail-viewing-as;
        }
        RailRow {
            label: root.tr-rail-today;
            pressed => { root.today-pressed(); }
        }
        GroupLabel { text: root.tr-rail-channels; }
        RailRow { label: root.data-channel-1; }
        RailRow {
            label: root.data-channel-2;
            selected: root.data-channel-2-selected;
        }
        RailRow { label: root.data-channel-3; }
        RailRow { label: root.data-channel-4; }
        GroupLabel { text: root.tr-rail-dm-people; }
        RailRow {
            label: root.data-person-1-note != "" ? root.data-person-1 + "　" + root.data-person-1-note : root.data-person-1;
        }
        RailRow {
            label: root.data-person-2-note != "" ? root.data-person-2 + "　" + root.data-person-2-note : root.data-person-2;
        }
        GroupLabel { text: root.tr-rail-dm-ai; }
        RailAiRow {
            label: root.data-ai-1;
            presence: root.data-ai-1-presence;
            tr-ai-badge: root.tr-ai-badge;
        }
        RailAiRow {
            label: root.data-ai-2;
            presence: root.data-ai-2-presence;
            tr-ai-badge: root.tr-ai-badge;
        }
        RailAiRow {
            label: root.data-ai-3;
            presence: root.data-ai-3-presence;
            tr-ai-badge: root.tr-ai-badge;
        }
    }
}

// ---- 上の帯 ----

component TopBar inherits Rectangle {
    background: DesignTokens.tile;
    in property <string> data-title;
    in property <string> data-members;
    in property <string> tr-search-placeholder;
    in property <string> tr-search-shortcut;
    VerticalLayout {
        HorizontalLayout {
            padding: 16px;
            padding-right: 22px;
            padding-left: 22px;
            spacing: 12px;
            Text {
                text: root.data-title;
                color: DesignTokens.ink;
                font-size: 22px;
                font-weight: 500;
                vertical-alignment: center;
            }
            Text {
                text: root.data-members;
                color: DesignTokens.mute;
                font-size: 13px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 260px;
                height: 34px;
                border-radius: 17px;
                background: DesignTokens.well;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.tr-search-placeholder;
                        color: DesignTokens.mute;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.tr-search-shortcut;
                        color: DesignTokens.sub;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: DesignTokens.line;
        }
    }
}

// ---- 「今日・判断待ち」の画面 ----

// 区切りの見出し（題名＋件数）。
component SectionHeading inherits HorizontalLayout {
    in property <string> heading;
    in property <int> count;
    padding: 10px;
    padding-bottom: 6px;
    spacing: 8px;
    Text {
        text: root.heading;
        color: DesignTokens.ink;
        font-size: 14px;
        font-weight: 500;
        vertical-alignment: center;
    }
    // 件数。値のバッジ用のトークンがまだないため、数字だけを並記する
    // （トークン確定後に見た目を整える）。
    Text {
        text: root.count;
        color: root.count > 0 ? DesignTokens.ink : DesignTokens.mute;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// 「自分の判断待ち」の 1 項目。依頼者・論点・待ち時間を出し、A/B の各案に
// 「この案に決める」を置く。「チャットで見る」で元のチャットへ戻る。
component PendingDecisionRow inherits Rectangle {
    in property <PendingItem> item;
    in property <string> tr-pending-wait;
    in property <string> tr-decision-choose;
    in property <string> tr-pending-open-chat;
    in property <string> tr-ai-badge;
    callback open-chat(string);
    callback decide(string, string, int);
    border-radius: 14px;
    background: DesignTokens.pending-bg;
    accessible-role: list-item;
    accessible-label: root.item.question;
    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 3px;
            background: DesignTokens.pending-bar;
        }
        AvatarView {
            is-ai: root.item.is-ai;
            initial: root.item.initial;
            a11y-label: root.item.requester + " " + (root.item.is-ai ? A11yStrings.tr-ai-bot-label : A11yStrings.tr-person-label);
        }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.requester;
                    color: DesignTokens.ink;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                if root.item.is-ai : AiBadgeView {
                    horizontal-stretch: 0;
                    label: root.tr-ai-badge;
                }
                Text {
                    text: root.item.channel;
                    color: DesignTokens.mute;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.tr-pending-wait + " " + root.item.wait;
                    color: DesignTokens.acc;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
            Text {
                text: root.item.question;
                color: DesignTokens.ink;
                font-size: 14px;
                wrap: word-wrap;
            }
            // A/B の各案。案の本文の横に「この案に決める」（決定は option-id で指す）。
            for opt in root.item.options : HorizontalLayout {
                spacing: 10px;
                Text {
                    text: opt.body;
                    color: DesignTokens.sub;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Pressable {
                    width: 96px;
                    height: 28px;
                    border-radius: 14px;
                    a11y-label: root.tr-decision-choose;
                    background: DesignTokens.primary-bg;
                    activated => { root.decide(root.item.decision-id, opt.option-id, root.item.version); }
                    key-hit(key, ctrl, shift) => {
                        return KeyRouter.decide-key(root.item.decision-id, opt.option-id, root.item.version, key, ctrl, shift);
                    }
                    Text {
                        text: root.tr-decision-choose;
                        color: DesignTokens.primary-fg;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
            // 元のチャットへ戻る導線。
            LinkText {
                text: root.tr-pending-open-chat;
                touched => { root.open-chat(root.item.decision-id); }
            }
        }
    }
}

// 「自分の依頼」の 1 項目（依頼の内容と進み具合。操作はしない）。
component MyRequestRow inherits Rectangle {
    in property <RequestItem> item;
    height: 48px;
    border-radius: 14px;
    background: DesignTokens.tile;
    accessible-role: list-item;
    accessible-label: root.item.text;
    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.meta;
                    color: DesignTokens.mute;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.item.progress;
                    color: DesignTokens.acc;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
            Text {
                text: root.item.text;
                color: DesignTokens.ink;
                font-size: 14px;
                overflow: elide;
            }
        }
    }
}

// 「今日・判断待ち」の画面。区切りは inbox.rs の定義に合わせた 2 つ
// （自分の判断待ち／自分の依頼。3 区分のモックは使わない）。
component TodayView inherits Rectangle {
    in property <string> tr-today-title;
    in property <string> tr-today-section-mine;
    in property <string> tr-today-section-requests;
    in property <string> tr-today-section-empty;
    in property <string> tr-today-quiet;
    in property <string> tr-pending-wait;
    in property <string> tr-pending-open-chat;
    in property <string> tr-decision-choose;
    in property <string> tr-ai-badge;
    in property <[PendingItem]> pending-items;
    in property <[RequestItem]> request-items;
    callback open-chat(string);
    callback decide(string, string, int);
    background: DesignTokens.tile;
    Flickable {
        VerticalLayout {
            padding: 24px;
            padding-top: 20px;
            spacing: 18px;
            alignment: start;
            Text {
                text: root.tr-today-title;
                color: DesignTokens.ink;
                font-size: 22px;
                font-weight: 500;
            }
            if root.pending-items.length == 0 && root.request-items.length == 0 : Text {
                text: root.tr-today-quiet;
                color: DesignTokens.sub;
                font-size: 14px;
                horizontal-alignment: center;
            }
            // 自分の判断待ち
            Rectangle {
                background: DesignTokens.well;
                border-radius: 20px;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    SectionHeading {
                        heading: root.tr-today-section-mine;
                        count: root.pending-items.length;
                    }
                    if root.pending-items.length == 0 : Text {
                        text: root.tr-today-section-empty;
                        color: DesignTokens.mute;
                        font-size: 13px;
                    }
                    for item in root.pending-items : pending-row := Rectangle {
                        PendingDecisionRow {
                            item: item;
                            tr-pending-wait: root.tr-pending-wait;
                            tr-decision-choose: root.tr-decision-choose;
                            tr-pending-open-chat: root.tr-pending-open-chat;
                            tr-ai-badge: root.tr-ai-badge;
                            open-chat(id) => { root.open-chat(id); }
                            decide(id, option-id, version) => { root.decide(id, option-id, version); }
                        }
                    }
                }
            }
            // 自分の依頼
            Rectangle {
                background: DesignTokens.well;
                border-radius: 20px;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    SectionHeading {
                        heading: root.tr-today-section-requests;
                        count: root.request-items.length;
                    }
                    if root.request-items.length == 0 : Text {
                        text: root.tr-today-section-empty;
                        color: DesignTokens.mute;
                        font-size: 13px;
                    }
                    for item in root.request-items : MyRequestRow {
                        item: item;
                    }
                }
            }
        }
    }
}

// ---- チャンネルの画面 ----

// メッセージ1件（人は円、AI は四角＋「AI」の印）。
component MessageRow inherits Rectangle {
    in property <string> data-sender;
    in property <bool> data-is-ai: false;
    in property <string> data-initial;
    in property <string> data-body;
    in property <string> data-time;
    in property <string> tr-ai-badge;
    in property <string> tr-mention-read-range;
    in property <bool> data-show-read-range: false;
    // 行とアバターの両方の読み上げに「表示名＋種別」を載せる（Issue 379）。
    accessible-role: list-item;
    accessible-label: root.data-sender + " " + (root.data-is-ai ? A11yStrings.tr-ai-bot-label : A11yStrings.tr-person-label);
    HorizontalLayout {
        padding: 6px;
        spacing: 12px;
        AvatarView {
            is-ai: root.data-is-ai;
            initial: root.data-initial;
            a11y-label: root.data-sender + " " + (root.data-is-ai ? A11yStrings.tr-ai-bot-label : A11yStrings.tr-person-label);
        }
        VerticalLayout {
            spacing: 2px;
            if root.data-show-read-range : LinkText {
                text: root.tr-mention-read-range;
                font-size: 12px;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.data-sender;
                    color: DesignTokens.ink;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                if root.data-is-ai : AiBadgeView {
                    horizontal-stretch: 0;
                    label: root.tr-ai-badge;
                }
                Text {
                    text: root.data-time;
                    color: DesignTokens.mute;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.data-body;
                color: DesignTokens.ink;
                font-size: 15px;
                wrap: word-wrap;
            }
        }
    }
}

// メッセージの下のスレッドへの導線（「返信 N 件」＋作業中/完了＋「作業を見る」）。
component ThreadLead inherits Rectangle {
    in property <string> tr-thread-replies;
    in property <string> tr-thread-working;
    in property <string> tr-thread-done;
    in property <string> tr-thread-view-work;
    in property <bool> data-working: false;
    in property <bool> data-done: true;
    callback view-work-pressed();
    height: 28px;
    border-radius: 12px;
    background: DesignTokens.well;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.tr-thread-replies;
            color: DesignTokens.acc;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
        Text {
            visible: root.data-working;
            text: root.tr-thread-working;
            color: DesignTokens.acc;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            visible: root.data-done && !root.data-working;
            text: root.tr-thread-done;
            color: DesignTokens.sub;
            font-size: 13px;
            vertical-alignment: center;
        }
        LinkText {
            text: root.tr-thread-view-work;
            vertical-alignment: center;
            horizontal-alignment: right;
            touched => { root.view-work-pressed(); }
        }
    }
}

// 決定の印（◆ 決定 · 誰 時刻）。
component DecisionMarkView inherits Rectangle {
    in property <string> tr-decision-mark;
    height: 24px;
    HorizontalLayout {
        padding-left: 46px;
        Text {
            text: root.tr-decision-mark;
            color: DesignTokens.ink;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// チャット内の判断カード（Issue 331）。判断待ち中は論点＋A/B の各案に「この案に
// 決める」を出し、確定後は確定内容・決定者・版の表示に変わる。
component DecisionCardView inherits Rectangle {
    in property <string> tr-decision-card-label;
    in property <string> tr-decision-choose;
    in property <string> tr-decision-outcome;
    in property <string> tr-ai-badge;
    in property <string> data-id;
    in property <int> data-version;
    in property <string> data-requester;
    in property <bool> data-requester-is-ai: false;
    in property <string> data-requester-initial;
    in property <string> data-question;
    in property <[DecisionOptionItem]> data-options;
    in property <bool> data-decided: false;
    in property <string> data-selected;
    in property <string> data-decider;
    callback decide(string, string, int);
    background: DesignTokens.well;
    border-radius: 14px;
    accessible-role: groupbox;
    accessible-label: root.tr-decision-card-label;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.tr-decision-card-label;
                color: DesignTokens.mute;
                font-size: 11px;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 6px;
                AvatarView {
                    width: 22px;
                    height: 22px;
                    border-radius: root.data-requester-is-ai ? 6px : 11px;
                    is-ai: root.data-requester-is-ai;
                    initial: root.data-requester-initial;
                    a11y-label: root.data-requester + " " + (root.data-requester-is-ai ? A11yStrings.tr-ai-bot-label : A11yStrings.tr-person-label);
                }
                Text {
                    text: root.data-requester;
                    color: DesignTokens.sub;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                // `if` だと条件の再評価が届かず子要素が実体化しない環境差がある
                // （CI の en で消失。カード自体が `if data-decision-visible` の
                // 中に実体化される入れ子の影響）。同じカード内のオプション行が
                // `for` で問題なく出るため、0/1 要素の for で出し分ける。
                // 人なら要素自体が無いので「隠す仕組み」にはならない。
                for _ai in (root.data-requester-is-ai ? [true] : []) : AiBadgeView {
                    horizontal-stretch: 0;
                    label: root.tr-ai-badge;
                }
            }
        }
        Text {
            text: root.data-question;
            color: DesignTokens.ink;
            font-size: 14px;
            font-weight: 500;
            wrap: word-wrap;
        }
        // 判断待ち中: A/B の各案に「この案に決める」（確定後は列挙しない）。
        for opt in root.data-decided ? [] : root.data-options : HorizontalLayout {
            spacing: 10px;
            Text {
                text: opt.body;
                color: DesignTokens.sub;
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Pressable {
                width: 96px;
                height: 28px;
                border-radius: 14px;
                a11y-label: root.tr-decision-choose;
                background: DesignTokens.primary-bg;
                activated => { root.decide(root.data-id, opt.option-id, root.data-version); }
                key-hit(key, ctrl, shift) => {
                    return KeyRouter.decide-key(root.data-id, opt.option-id, root.data-version, key, ctrl, shift);
                }
                Text {
                    text: root.tr-decision-choose;
                    color: DesignTokens.primary-fg;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
        // 確定後: 確定内容・決定者・版の表示。
        if root.data-decided : VerticalLayout {
            spacing: 4px;
            Text {
                text: root.data-selected;
                color: DesignTokens.ink;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: root.tr-decision-outcome + " · " + root.data-decider + " · v" + root.data-version;
                color: DesignTokens.sub;
                font-size: 11px;
            }
        }
    }
}

// 引き継ぎカード。
component HandoffCardView inherits Rectangle {
    in property <string> tr-handoff-context;
    in property <string> tr-handoff-acknowledged;
    in property <string> tr-handoff-not-acknowledged;
    in property <string> tr-handoff-acknowledge;
    in property <string> tr-handoff-decision-owner;
    in property <string> data-from-to;
    in property <string> data-title;
    in property <bool> data-acknowledged: true;
    in property <string> data-option-a;
    in property <string> data-option-b;
    callback acknowledge-pressed();
    background: DesignTokens.well;
    border-radius: 14px;
    VerticalLayout {
        padding: 9px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.data-from-to + "　" + root.data-title;
                color: DesignTokens.ink;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
            LinkText {
                text: root.tr-handoff-context;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            if !root.data-acknowledged : Text {
                text: root.tr-handoff-not-acknowledged;
                color: DesignTokens.ink;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.data-acknowledged : Text {
                text: root.tr-handoff-acknowledged;
                color: DesignTokens.sub;
                font-size: 11px;
                vertical-alignment: center;
            }
            if !root.data-acknowledged : Pressable {
                height: 28px;
                border-radius: 14px;
                a11y-label: root.tr-handoff-acknowledge;
                background: DesignTokens.ink;
                activated => { root.acknowledge-pressed(); }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.tr-handoff-acknowledge;
                        color: DesignTokens.well;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: root.tr-handoff-decision-owner;
            color: DesignTokens.ink;
            font-size: 12px;
        }
        Text {
            text: root.data-option-a;
            color: DesignTokens.sub;
            font-size: 13px;
        }
        Text {
            text: root.data-option-b;
            color: DesignTokens.sub;
            font-size: 13px;
        }
    }
}

// 「あなただけに表示」の行。
component PrivateNoteRow inherits Rectangle {
    in property <string> tr-message-private-note;
    in property <string> tr-ai-badge;
    in property <string> data-sender;
    in property <bool> data-is-ai: false;
    in property <string> data-initial;
    in property <string> data-body;
    background: DesignTokens.private-bg;
    border-radius: 14px;
    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 4px;
        Text {
            text: root.tr-message-private-note;
            color: DesignTokens.sub;
            font-size: 11px;
        }
        HorizontalLayout {
            spacing: 12px;
            AvatarView {
                is-ai: root.data-is-ai;
                initial: root.data-initial;
                a11y-label: root.data-sender + " " + (root.data-is-ai ? A11yStrings.tr-ai-bot-label : A11yStrings.tr-person-label);
            }
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.data-sender;
                        color: DesignTokens.ink;
                        font-size: 13px;
                    }
                    if root.data-is-ai : AiBadgeView {
                        horizontal-stretch: 0;
                        label: root.tr-ai-badge;
                    }
                }
                Text {
                    text: root.data-body;
                    color: DesignTokens.ink;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// 社外への送信の確認カード（「送る」「直す」と鍵の注記）と送信後の表示。
component ExternalSendCardView inherits Rectangle {
    in property <string> tr-ext-card-label;
    in property <string> tr-ext-card-question;
    in property <string> tr-ext-address-label;
    in property <string> tr-ext-subject-label;
    in property <string> tr-ext-basis-label;
    in property <string> tr-ext-send;
    in property <string> tr-ext-fix;
    in property <string> tr-ext-lock-note;
    in property <string> tr-ext-sent;
    in property <string> data-address;
    in property <string> data-subject;
    in property <string> data-basis;
    in property <string> data-body;
    in property <bool> data-sent: false;
    callback send-pressed();
    callback fix-pressed();
    background: DesignTokens.ext-bg;
    border-radius: 18px;
    VerticalLayout {
        padding: 16px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 4px;
        Text {
            text: root.tr-ext-card-label;
            color: DesignTokens.ext-label;
            font-size: 11px;
        }
        Text {
            text: root.tr-ext-card-question;
            color: DesignTokens.ext-fg;
            font-size: 16px;
            font-weight: 500;
        }
        if !root.data-sent : Rectangle {
            border-radius: 12px;
            background: DesignTokens.ext-body-bg;
            VerticalLayout {
                padding: 10px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                Text {
                    text: root.tr-ext-address-label + " " + root.data-address;
                    color: DesignTokens.ext-address;
                    font-size: 11px;
                }
                Text {
                    text: root.tr-ext-subject-label + " " + root.data-subject;
                    color: DesignTokens.ext-meta;
                    font-size: 11px;
                }
                Text {
                    text: root.tr-ext-basis-label + " " + root.data-basis;
                    color: DesignTokens.ext-link;
                    font-size: 11px;
                }
                Text {
                    text: root.data-body;
                    color: DesignTokens.ext-body-fg;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
        if !root.data-sent : Rectangle {
            height: 1px;
            background: DesignTokens.ext-divider;
        }
        if !root.data-sent : HorizontalLayout {
            spacing: 10px;
            height: 36px;
            // 「送る」（主操作）。押せるかは Rust 側（ApprovalCardBridge）が決める。
            Pressable {
                width: 96px;
                border-radius: 18px;
                a11y-label: root.tr-ext-send;
                background: DesignTokens.ext-go-bg;
                activated => { root.send-pressed(); }
                key-hit(key, ctrl, shift) => {
                    return KeyRouter.send-key(key, ctrl, shift);
                }
                Text {
                    text: root.tr-ext-send;
                    color: DesignTokens.ext-go-fg;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            // 「直す」。
            Pressable {
                width: 80px;
                border-radius: 18px;
                border-width: 1px;
                border-color: DesignTokens.ext-fx-line;
                a11y-label: root.tr-ext-fix;
                activated => { root.fix-pressed(); }
                Text {
                    text: root.tr-ext-fix;
                    color: DesignTokens.ext-fx-fg;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Text {
                text: root.tr-ext-lock-note;
                color: DesignTokens.ext-label;
                font-size: 11px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
        // 送信後の表示。
        if root.data-sent : Text {
            text: root.tr-ext-sent;
            color: DesignTokens.success-fg;
            font-size: 13px;
        }
    }
}

// チャンネルの画面（時系列＋入力欄）。
component ChannelView inherits Rectangle {
