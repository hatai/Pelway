    in property <string> tr-decision-mark;
    in property <string> tr-message-private-note;
    in property <string> tr-thread-replies;
    in property <string> tr-thread-working;
    in property <string> tr-thread-done;
    in property <string> tr-thread-view-work;
    in property <string> tr-mention-read-range;
    in property <string> tr-handoff-context;
    in property <string> tr-handoff-acknowledged;
    in property <string> tr-handoff-not-acknowledged;
    in property <string> tr-handoff-acknowledge;
    in property <string> tr-handoff-decision-owner;
    in property <string> tr-ext-card-label;
    in property <string> tr-ext-card-question;
    in property <string> tr-ext-address-label;
    in property <string> tr-ext-subject-label;
    in property <string> tr-ext-basis-label;
    in property <string> tr-ext-send;
    in property <string> tr-ext-fix;
    in property <string> tr-ext-lock-note;
    in property <string> tr-ext-sent;
    in property <string> tr-pane-thread-title;
    in property <string> tr-pane-close;
    in property <string> tr-pane-back-to-thread;
    in property <string> tr-pane-ai-work-title;
    in property <string> tr-pane-ai-steps;
    in property <string> tr-pane-ai-from;
    in property <string> tr-pane-ai-read-range;
    in property <string> tr-pane-ai-note;
    in property <string> tr-thread-input-placeholder;
    in property <string> tr-composer-placeholder;
    // トップレベルメニューと About ダイアログ（Slint の attribution、Issue 237）
    in property <string> tr-menu-help;
    in property <string> tr-menu-about;
    in property <string> tr-about-title;
    in property <string> tr-about-close;

    // 表示の切替（骨組みでは Rust から切り替える）。
    in property <bool> show-today: true;
    in property <bool> show-right-pane: true;
    in property <bool> right-pane-ai-work: false;
    // About ダイアログの表示。トップレベルメニューの項目から開き、「閉じる」で
    // 閉じる（Slint 側で書き、Rust からも読むため in-out）。
    in-out property <bool> show-about: false;

    // 合成データ（モックの架空の会社名・人名のみ）。
    in property <string> data-org-name;
    in property <string> data-channel-1;
    in property <string> data-channel-2;
    in property <string> data-channel-3;
    in property <string> data-channel-4;
    in property <string> data-person-1;
    in property <string> data-person-1-note;
    in property <string> data-person-2;
    in property <string> data-person-2-note;
    in property <string> data-ai-1-name;
    in property <string> data-ai-1-presence;
    in property <string> data-ai-2-name;
    in property <string> data-ai-2-presence;
    in property <string> data-ai-3-name;
    in property <string> data-ai-3-presence;
    in property <string> data-channel-title;
    in property <string> data-channel-members;
    in property <int> data-consultations-count;
    in property <int> data-pending-count;
    in property <int> data-decided-count;
    in property <bool> data-c1-is-ai: false;
    in property <string> data-c1-initial;
    in property <string> data-c1-meta;
    in property <string> data-c1-text;
    in property <bool> data-c2-is-ai: false;
    in property <string> data-c2-initial;
    in property <string> data-c2-meta;
    in property <string> data-c2-text;
    in property <bool> data-p1-is-ai: false;
    in property <string> data-p1-initial;
    in property <string> data-p1-meta;
    in property <string> data-p1-text;
    in property <bool> data-d1-is-ai: false;
    in property <string> data-d1-initial;
    in property <string> data-d1-meta;
    in property <string> data-d1-text;
    in property <string> data-day-label;
    in property <string> data-msg1-sender;
    in property <string> data-msg1-initial;
    in property <string> data-msg1-time;
    in property <string> data-msg1-body;
    in property <string> data-msg2-sender;
    in property <string> data-msg2-initial;
    in property <string> data-msg2-time;
    in property <string> data-msg2-body;
    in property <bool> data-msg2-thread-done: true;
    in property <string> data-handoff-from-to;
    in property <string> data-handoff-title;
    in property <bool> data-handoff-acknowledged: true;
    in property <string> data-handoff-option-a;
    in property <string> data-handoff-option-b;
    in property <string> data-msg3-sender;
    in property <string> data-msg3-initial;
    in property <string> data-msg3-time;
    in property <string> data-msg3-body;
    in property <string> data-note-sender;
    in property <string> data-note-initial;
    in property <string> data-note-body;
    in property <string> data-ext-address;
    in property <string> data-ext-subject;
    in property <string> data-ext-basis;
    in property <string> data-ext-body;
    in property <bool> data-ext-sent: false;
    in property <string> data-thread-msg1-sender;
    in property <string> data-thread-msg1-initial;
    in property <bool> data-thread-msg1-is-ai: true;
    in property <string> data-thread-msg1-time;
    in property <string> data-thread-msg1-body;
    in property <string> data-thread-msg2-sender;
    in property <string> data-thread-msg2-initial;
    in property <bool> data-thread-msg2-is-ai: false;
    in property <string> data-thread-msg2-time;
    in property <string> data-thread-msg2-body;
    in property <string> data-ai-work-name;
    in property <string> data-ai-work-initial;
    in property <int> data-ai-work-steps-done;
    in property <int> data-ai-work-steps-total;
    in property <string> data-ai-work-source;
    in property <int> data-ai-work-read-range;
    in property <string> data-ai-work-log1-time;
    in property <string> data-ai-work-log1-text;
    in property <string> data-ai-work-log2-time;
    in property <string> data-ai-work-log2-text;

    callback today-pressed();
    callback send-pressed();
    callback fix-pressed();
    callback acknowledge-pressed();
    callback close-pane-pressed();
    callback back-to-thread-pressed();
    callback view-work-pressed();

    background: DesignTokens.bg;
    // トップレベルメニュー。About ダイアログへの到達経路（Issue 237）。Window の中に
    // 1つだけ置ける（Slint の決まり）。プラットフォームによって描かれ方が変わる
    // （macOS では画面上部のネイティブメニューになる）。
    MenuBar {
        Menu {
            title: root.tr-menu-help;
            MenuItem {
                title: root.tr-menu-about;
                activated => { root.show-about = true; }
            }
        }
    }
    HorizontalLayout {
        padding: 20px;
        spacing: 16px;
        // 左の列（rail）
        RailView {
            width: 220px;
            tr-rail-viewing-as: root.tr-rail-viewing-as;
            tr-rail-today: root.tr-rail-today;
            tr-rail-channels: root.tr-rail-channels;
            tr-rail-dm-people: root.tr-rail-dm-people;
            tr-rail-dm-ai: root.tr-rail-dm-ai;
            data-org-name: root.data-org-name;
            data-channel-1: root.data-channel-1;
            data-channel-2: root.data-channel-2;
            data-channel-3: root.data-channel-3;
            data-channel-4: root.data-channel-4;
            data-channel-2-selected: root.data-channel-2 == root.data-channel-title;
            data-person-1: root.data-person-1;
            data-person-1-note: root.data-person-1-note;
            data-person-2: root.data-person-2;
            data-person-2-note: root.data-person-2-note;
            data-ai-1: root.data-ai-1-name;
            data-ai-1-presence: root.data-ai-1-presence;
            data-ai-2: root.data-ai-2-name;
            data-ai-2-presence: root.data-ai-2-presence;
            data-ai-3: root.data-ai-3-name;
            data-ai-3-presence: root.data-ai-3-presence;
            today-pressed => { root.today-pressed(); }
        }
        // 中央（上の帯＋本文＋入力欄）
        Rectangle {
            background: DesignTokens.tile;
            border-radius: 24px;
            VerticalLayout {
                TopBar {
                    data-title: root.show-today ? root.tr-today-title : root.data-channel-title;
                    data-members: root.show-today ? "" : root.data-channel-members;
                    tr-search-placeholder: root.tr-search-placeholder;
                    tr-search-shortcut: root.tr-search-shortcut;
                }
                if root.show-today : TodayView {
                    tr-today-title: root.tr-today-title;
                    tr-today-section-consultations: root.tr-today-section-consultations;
                    tr-today-section-pending: root.tr-today-section-pending;
                    tr-today-section-decided: root.tr-today-section-decided;
                    tr-today-section-empty: root.tr-today-section-empty;
                    tr-today-quiet: root.tr-today-quiet;
                    data-consultations-count: root.data-consultations-count;
                    data-pending-count: root.data-pending-count;
                    data-decided-count: root.data-decided-count;
                    data-quiet: root.data-consultations-count + root.data-pending-count + root.data-decided-count == 0;
                    data-c1-is-ai: root.data-c1-is-ai;
                    data-c1-initial: root.data-c1-initial;
                    data-c1-meta: root.data-c1-meta;
                    data-c1-text: root.data-c1-text;
                    data-c2-is-ai: root.data-c2-is-ai;
                    data-c2-initial: root.data-c2-initial;
                    data-c2-meta: root.data-c2-meta;
                    data-c2-text: root.data-c2-text;
                    data-p1-is-ai: root.data-p1-is-ai;
                    data-p1-initial: root.data-p1-initial;
                    data-p1-meta: root.data-p1-meta;
                    data-p1-text: root.data-p1-text;
                    data-d1-is-ai: root.data-d1-is-ai;
                    data-d1-initial: root.data-d1-initial;
                    data-d1-meta: root.data-d1-meta;
                    data-d1-text: root.data-d1-text;
                }
                if !root.show-today : ChannelView {
                    tr-unread-divider: root.tr-unread-divider;
                    tr-ai-badge: root.tr-ai-badge;
                    tr-decision-mark: root.tr-decision-mark;
                    tr-message-private-note: root.tr-message-private-note;
                    tr-thread-replies: root.tr-thread-replies;
                    tr-thread-working: root.tr-thread-working;
                    tr-thread-done: root.tr-thread-done;
                    tr-thread-view-work: root.tr-thread-view-work;
                    tr-mention-read-range: root.tr-mention-read-range;
                    tr-handoff-context: root.tr-handoff-context;
                    tr-handoff-acknowledged: root.tr-handoff-acknowledged;
                    tr-handoff-not-acknowledged: root.tr-handoff-not-acknowledged;
                    tr-handoff-acknowledge: root.tr-handoff-acknowledge;
                    tr-handoff-decision-owner: root.tr-handoff-decision-owner;
                    tr-ext-card-label: root.tr-ext-card-label;
                    tr-ext-card-question: root.tr-ext-card-question;
                    tr-ext-address-label: root.tr-ext-address-label;
                    tr-ext-subject-label: root.tr-ext-subject-label;
                    tr-ext-basis-label: root.tr-ext-basis-label;
                    tr-ext-send: root.tr-ext-send;
                    tr-ext-fix: root.tr-ext-fix;
                    tr-ext-lock-note: root.tr-ext-lock-note;
                    tr-ext-sent: root.tr-ext-sent;
                    tr-composer-placeholder: root.tr-composer-placeholder;
                    data-day-label: root.data-day-label;
                    data-msg1-sender: root.data-msg1-sender;
                    data-msg1-initial: root.data-msg1-initial;
                    data-msg1-time: root.data-msg1-time;
                    data-msg1-body: root.data-msg1-body;
                    data-msg2-sender: root.data-msg2-sender;
                    data-msg2-is-ai: true;
                    data-msg2-initial: root.data-msg2-initial;
                    data-msg2-time: root.data-msg2-time;
                    data-msg2-body: root.data-msg2-body;
                    data-msg2-thread-done: root.data-msg2-thread-done;
                    data-handoff-from-to: root.data-handoff-from-to;
                    data-handoff-title: root.data-handoff-title;
                    data-handoff-acknowledged: root.data-handoff-acknowledged;
                    data-handoff-option-a: root.data-handoff-option-a;
                    data-handoff-option-b: root.data-handoff-option-b;
                    data-msg3-sender: root.data-msg3-sender;
                    data-msg3-initial: root.data-msg3-initial;
                    data-msg3-time: root.data-msg3-time;
                    data-msg3-body: root.data-msg3-body;
                    data-note-sender: root.data-note-sender;
                    data-note-is-ai: true;
                    data-note-initial: root.data-note-initial;
                    data-note-body: root.data-note-body;
                    data-ext-address: root.data-ext-address;
                    data-ext-subject: root.data-ext-subject;
                    data-ext-basis: root.data-ext-basis;
                    data-ext-body: root.data-ext-body;
                    data-ext-sent: root.data-ext-sent;
                    send-pressed => { root.send-pressed(); }
                    fix-pressed => { root.fix-pressed(); }
                    acknowledge-pressed => { root.acknowledge-pressed(); }
                    view-work-pressed => { root.view-work-pressed(); }
                }
            }
        }
        // 右の枠（スレッド・AIの作業）
        if root.show-right-pane && !root.right-pane-ai-work : ThreadPaneView {
            width: 400px;
            tr-pane-thread-title: root.tr-pane-thread-title;
            tr-pane-close: root.tr-pane-close;
            tr-thread-working: root.tr-thread-working;
            tr-thread-done: root.tr-thread-done;
            tr-thread-view-work: root.tr-thread-view-work;
            tr-thread-input-placeholder: root.tr-thread-input-placeholder;
            tr-ai-badge: root.tr-ai-badge;
            tr-mention-read-range: root.tr-mention-read-range;
            data-channel: root.data-channel-title;
            data-msg1-sender: root.data-thread-msg1-sender;
            data-msg1-is-ai: root.data-thread-msg1-is-ai;
            data-msg1-initial: root.data-thread-msg1-initial;
            data-msg1-time: root.data-thread-msg1-time;
            data-msg1-body: root.data-thread-msg1-body;
            data-msg2-sender: root.data-thread-msg2-sender;
            data-msg2-is-ai: root.data-thread-msg2-is-ai;
            data-msg2-initial: root.data-thread-msg2-initial;
            data-msg2-time: root.data-thread-msg2-time;
            data-msg2-body: root.data-thread-msg2-body;
            data-done: root.data-msg2-thread-done;
            close-pressed => { root.close-pane-pressed(); }
            view-work-pressed => { root.view-work-pressed(); }
        }
        if root.show-right-pane && root.right-pane-ai-work : AiWorkPaneView {
            width: 400px;
            tr-pane-back-to-thread: root.tr-pane-back-to-thread;
            tr-pane-ai-work-title: root.tr-pane-ai-work-title;
            tr-pane-ai-steps: root.tr-pane-ai-steps;
            tr-pane-ai-from: root.tr-pane-ai-from;
            tr-pane-ai-read-range: root.tr-pane-ai-read-range;
            tr-pane-ai-note: root.tr-pane-ai-note;
            data-ai-name: root.data-ai-work-name;
            data-ai-initial: root.data-ai-work-initial;
            data-steps-done: root.data-ai-work-steps-done;
            data-steps-total: root.data-ai-work-steps-total;
            data-source: root.data-ai-work-source;
            data-read-range: root.data-ai-work-read-range;
            data-log1-time: root.data-ai-work-log1-time;
            data-log1-text: root.data-ai-work-log1-text;
            data-log2-time: root.data-ai-work-log2-time;
            data-log2-text: root.data-ai-work-log2-text;
            back-pressed => { root.back-to-thread-pressed(); }
        }
    }
    // About のダイアログ（メニューの項目で開く）。内容の上に重ねる。
    if root.show-about : AboutDialogView {
        tr-about-title: root.tr-about-title;
        tr-about-close: root.tr-about-close;
        close-pressed => { root.show-about = false; }
    }
}
