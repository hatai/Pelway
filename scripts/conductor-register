#!/usr/bin/env bash
# いまの指揮役の T3 スレッド ID を、agent-watch の起こしの宛先として登録する（Issue #555）。
# 登録ファイルは ~/.config/pelway-agent-notify/conductor-thread-id（webhook の秘密の設定と同じ置き場）で、
# sandbox の中からは書けない。代行の指揮役を始めるとき・立て直すときに、hatai がホストで実行する。
#
#   scripts/conductor-register <thread-id>   登録（置き換え）
#   scripts/conductor-register --clear       登録を消す（代行の終了）
#   scripts/conductor-register --show        いまの登録を表示する
#
# ID は agent-watch と同じ規則で確かめる（先頭の - を拒み、英数字と : _ - . % だけ、256 文字まで）。
set -euo pipefail

DIR="$HOME/.config/pelway-agent-notify"
FILE="$DIR/conductor-thread-id"

usage() { sed -n '5,7p' "$0" | sed 's/^# //' >&2; exit 2; }

[[ $# -eq 1 ]] || usage
case "$1" in
  --clear) rm -f -- "$FILE"; echo "conductor-register: cleared"; exit 0 ;;
  --show) if [[ -f "$FILE" ]]; then head -n1 -- "$FILE"; else echo "(none)"; fi; exit 0 ;;
  -*) echo "conductor-register: the thread id must not start with '-'" >&2; exit 1 ;;
esac

id="$1"
if [[ ! "$id" =~ ^[A-Za-z0-9:_.%-]{1,256}$ ]]; then
  echo "conductor-register: not a thread id (letters, digits, ':', '_', '-', '.', '%'; up to 256)" >&2
  exit 1
fi

mkdir -p -- "$DIR"
chmod 700 -- "$DIR"
tmp="$(mktemp "$DIR/.conductor-thread-id.XXXXXX")"
trap 'rm -f -- "$tmp"' EXIT
printf '%s\n' "$id" > "$tmp"
chmod 600 -- "$tmp"
mv -f -- "$tmp" "$FILE"
trap - EXIT
echo "conductor-register: registered"
