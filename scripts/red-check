#!/usr/bin/env bash
# 新しい試験が前の実装で落ちること（red）を、作業ツリーを触らずに確かめる。
#   scripts/red-check <ref> [--keep <パス>...] -- <コマンド...>
# <ref> の一時 worktree（detached）を作り、--keep に挙げたファイル・ディレクトリだけを今の作業ツリーから
# 同じ相対パスに写して重ね、worktree の最上位で <コマンド> を走らせる。終わったら一時 worktree を消す。
# 重ねるものは --keep で明示したものだけで、自動では選ばない（未追跡のファイルも挙げれば写す）。
# --keep のパスは今いるディレクトリからの相対パスか絶対パスで、リポジトリの中を指す。
# <コマンド> には MISE_TRUSTED_CONFIG_PATHS の先頭に一時 worktree を足して渡す（一時 worktree の mise.toml は
# mise に信頼されていないため。mise trust と違い、mise の状態に記録を残さない）。
# 終了コード: <コマンド> の終了コード。2 = 引数の誤り（-- が無い・コマンドが無い・--keep のパスが
# 作業ツリーに無いかリポジトリの外、最後の要素が . か ..）、3 = 準備の失敗（一時 worktree を作れない・
# --keep のパスを重ねられない・<ref> 側で重ね先の親が一時 worktree の外を指す symlink）。準備に失敗したときはコマンドを走らせない（red の失敗と見分けるため）。
set -euo pipefail

usage() {
  echo "usage: $0 <ref> [--keep <パス>...] -- <コマンド...>" >&2
  exit 2
}

case "${1:-}" in
  -h|--help)
    printf '%s\n' \
      "usage: $0 <ref> [--keep <パス>...] -- <コマンド...>" \
      "" \
      "<ref> の一時 worktree に --keep のファイルを今の作業ツリーから重ね、<コマンド> を worktree の最上位で走らせる。" \
      "終了コードは <コマンド> のもの。走らせた後に一時 worktree を消す。重ねるファイルは自動で選ばない。" \
      "例: $0 origin/main --keep scripts/tests/foo.test.sh -- bash scripts/tests/foo.test.sh"
    exit 0
    ;;
  ""|--*) usage ;;
esac
ref="$1"
shift

keeps=()
while (($#)) && [[ "$1" != "--" ]]; do
  if [[ "$1" == "--keep" ]]; then
    shift
    while (($#)) && [[ "$1" != "--" && "$1" != "--keep" ]]; do
      keeps+=("$1")
      shift
    done
  else
    usage
  fi
done
[[ "${1:-}" == "--" ]] || usage
shift
(($#)) || usage

top="$(git rev-parse --show-toplevel)" || exit 2

# --keep のパスをリポジトリの最上位からの相対パスにする。作業ツリーに無いものは走らせる前に止める。
rels=()
for k in ${keeps[@]+"${keeps[@]}"}; do
  case "/$k" in
    */.|*/..|*/./|*/../)
      echo "red-check: --keep のパスの最後の要素が . か .. です（ファイルかディレクトリの名前で指定する）: $k" >&2
      exit 2
      ;;
  esac
  if [[ ! -e "$k" ]]; then
    echo "red-check: --keep のパスが作業ツリーにありません: $k" >&2
    exit 2
  fi
  abs="$(cd "$(dirname "$k")" && pwd -P)/$(basename "$k")"
  case "$abs" in
    "$(cd "$top" && pwd -P)"/*) rels+=("${abs#"$(cd "$top" && pwd -P)"/}") ;;
    *) echo "red-check: --keep のパスがリポジトリの外です: $k" >&2; exit 2 ;;
  esac
done

wt="$(mktemp -d)"
cleanup() {
  git -C "$top" worktree remove --force "$wt" >/dev/null 2>&1 || true
  rm -rf -- "$wt"
  git -C "$top" worktree prune >/dev/null 2>&1 || true
}
trap cleanup EXIT

if ! git -C "$top" worktree add --quiet --detach "$wt" "$ref" >&2; then
  echo "red-check: $ref の一時 worktree を作れません" >&2
  exit 3
fi

# 重ねる先の親を、今ある祖先までさかのぼって実体パスにし、一時 worktree の中に収まることを確かめる。
# <ref> 側で親が worktree の外を指す symlink だと、削除・mkdir・コピーがその先に及ぶため、重ねる前に止める。
wt_real="$(cd "$wt" && pwd -P)"
inside_worktree() {
  local d="$1"
  while [[ ! -e "$d" && ! -L "$d" ]]; do
    d="$(dirname "$d")"
  done
  [[ ! -L "$d" || -d "$d" ]] || return 1 # リンク先の無い symlink は行き先を確かめられないので外と見なす
  [[ -d "$d" ]] || return 0               # 祖先が通常のファイルなら mkdir が失敗する（下で 3 になる）
  d="$(cd "$d" && pwd -P)"
  [[ "$d" == "$wt_real" || "$d" == "$wt_real"/* ]]
}

for r in ${rels[@]+"${rels[@]}"}; do
  if ! inside_worktree "$(dirname "$wt/$r")"; then
    echo "red-check: --keep のパスの重ね先が $ref の一時 worktree の外に出ます（親が外への symlink）: $r" >&2
    exit 3
  fi
  if ! { rm -rf -- "${wt:?}/$r" && mkdir -p "$(dirname "$wt/$r")" && cp -a -- "$top/$r" "$wt/$r"; }; then
    echo "red-check: --keep のパスを $ref の一時 worktree に重ねられません: $r" >&2
    exit 3
  fi
done

echo "red-check: $ref ($(git -C "$wt" rev-parse --short HEAD)) に ${#rels[@]} 個を重ねて実行: $*" >&2
rc=0
(cd "$wt" && MISE_TRUSTED_CONFIG_PATHS="$wt${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}" "$@") || rc=$?
exit "$rc"
