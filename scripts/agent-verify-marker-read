#!/usr/bin/env python3
# agent-gh-verify-gate が印を一度だけ開いて検査するための読み取り器（#807）。
# 属性と内容を同じ fd から取り、木・verify-id・内容と stat の指紋を tab 区切りで返す。
import hashlib, os, re, stat, sys

MARKER_RE = re.compile(rb"^(?:[0-9a-f]{40}|[0-9a-f]{64})\nverify-id:([0-9a-f]{32})\n$")
MARKER_SIZES = (84, 108)

def fail(message):
    print(f"agent-verify-marker-read: {message}", file=sys.stderr)
    sys.exit(1)

def main():
    if len(sys.argv) != 2: fail("usage: agent-verify-marker-read MARKER")
    path = sys.argv[1]
    try: fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as e: fail(f"印を開けません: {e}")
    try:
        try: st = os.fstat(fd)
        except OSError as e: fail(f"印を確かめられません: {e}")
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_nlink != 1 or st.st_size not in MARKER_SIZES:
            fail("印が信頼できる通常ファイルではありません")
        data = b""
        try:
            while len(data) < st.st_size:
                chunk = os.read(fd, st.st_size - len(data))
                if not chunk: break
                data += chunk
        except OSError as e: fail(f"印を読めません: {e}")
        if len(data) != st.st_size: fail("印を最後まで読めません")
        match = MARKER_RE.fullmatch(data)
        if match is None: fail("印の形を判定できません")
        tree = data.split(b"\n", 1)[0].decode("ascii")
        verify_id = match.group(1).decode("ascii")
        content_fp = hashlib.sha256(data).hexdigest()
        stat_key = f"stat:{st.st_dev}:{st.st_ino}:{st.st_size}:{int(st.st_mtime)}".encode()
        stat_fp = hashlib.sha256(stat_key).hexdigest()
        print(f"{tree}\t{verify_id}\t{content_fp}\t{stat_fp}")
    finally:
        os.close(fd)

if __name__ == "__main__":
    main()
