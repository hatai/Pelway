# PGroonga 計測用イメージ（rootless Podman でのビルド・実行を前提）。
# 由来: pgroonga/docker リポジトリの alpine/16/Dockerfile（PGroonga 4.1.0 /
# Groonga 16.1.3、PostgreSQL License 系）。配布イメージの pull がこの環境では
# できなかったため、公式 Dockerfile と同じ手順をローカルビルドにする。
# 出典: https://github.com/pgroonga/docker/blob/main/alpine/16/Dockerfile
#       https://github.com/pgroonga/docker/blob/main/alpine/build.sh
FROM docker.io/library/postgres:16-alpine

ENV PGROONGA_VERSION=4.1.0 \
    GROONGA_VERSION=16.1.3

COPY build-pgroonga.sh /
RUN apk add --no-cache --virtual=.build-dependencies \
      apache-arrow-dev \
      build-base \
      clang20-dev \
      cmake \
      gettext-dev \
      linux-headers \
      llvm20 \
      lz4-dev \
      meson \
      msgpack-c-dev \
      rapidjson-dev \
      ruby \
      samurai \
      xsimd-dev \
      xxhash-dev \
      zlib-dev \
      zstd-dev \
 && /build-pgroonga.sh "${PGROONGA_VERSION}" "${GROONGA_VERSION}" \
 && rm -f /build-pgroonga.sh \
 && apk del .build-dependencies \
 && apk add --no-cache \
      libarrow \
      libgomp \
      libxxhash \
      msgpack-c \
      zlib \
      zstd
