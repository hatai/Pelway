#!/usr/bin/env bash
# mise run verify の本体（#807）。前回の印を消してから 3 グループを並列に検査し、
# すべて成功したときだけ、検証した作業ツリーの木の印を残す。
set -uo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bash "$script_dir/agent-verify-invalidate" || exit 1
rc=0
mise run verify-lint ::: verify-test ::: verify-static || rc=$?
if ((rc != 0)); then
  exit "$rc"
fi
bash "$script_dir/agent-verify-record"
