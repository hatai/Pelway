#!/usr/bin/env bash
# リポジトリルートの agent-team.toml（+ 同じディレクトリの agent-team.local.toml の上書き）の
# 検証と読み出し（Issue #713・#804）。
# 使い方:
#   scripts/agent-team-config validate [<file>]          検証する。<file> の既定はルートの agent-team.toml
#   scripts/agent-team-config slots <login> [<file>]     その開発者の実装・調査の枠を「<担当> <上限>」で 1 行 1 つ出す
#                                                        （validate と同じ検証を通してから出す。違反があれば非 0 で標準出力は空）
#   scripts/agent-team-config effective <login> [<file>] 重ねた結果（その開発者の表と担当の登録情報）を JSON で出す。
#                                                        手順書・skill で toml を直接読む代わりに使う
#   scripts/agent-team-config -h | --help                この使い方を出す
# 終了コード: 0 = 成功、1 = 検証の失敗・TOML として読めない・読み出せない、2 = 引数の誤り・ファイルが無い
# agent-team.local.toml（追跡しない開発者ごとの上書き）は <file> と同じディレクトリから読む。
# 上書きできる項目とできない項目の表は docs/superpowers/specs/agent-team.md「開発者ごとの上書き」。
# 上書きできない項目はキー名と理由を標準エラーに警告して無視する（黙って適用も黙って無視もしない）。
# TOML は python3 の tomllib で読み、scripts/conductor-watch.sh と同じ python3 -I で起動する。
set -uo pipefail

usage_text="usage: $0 <validate [<file>] | slots <login> [<file>] | effective <login> [<file>]>"

usage() { echo "$usage_text" >&2; exit 2; }

help() {
  cat <<EOF
$usage_text

agent-team.toml（リポジトリルート）の検証と読み出し。
同じディレクトリに agent-team.local.toml（追跡しない開発者ごとの上書き）があれば、
許可された項目だけを共有の toml の上に重ねてから検証・読み出しする。
検証は scripts/tests/agent-team-config.test.sh 経由で mise run verify（script-test）に入る。

subcommands:
  validate [<file>]        ファイルを検証する。<file> の既定は <root>/agent-team.toml。
                            local があれば重ねた結果も検証する。違反は 1 行 1 つ
                            「<file>: <キー>: <内容>」を標準エラーに出し、
                            1 件でもあれば終了コード 1。合格なら 1 行だけ標準出力に出す
  slots <login> [<file>]   開発者 <login>（GitHub の login）の実装・調査の同時枠を
                            「<担当> <上限>」で 1 行 1 つ、ファイルの並びどおりに出す。
                            validate と同じ検証を通してから出し、違反があれば
                            標準出力には何も出さずに終了コード 1 で止まる
  effective <login> [<file> [<local-file>]]
                            重ねた結果を JSON で出す（agents の登録情報と、その
                            developers.<login> の表だけ）。手順書・skill で
                            toml を直接読む代わりに使う。<local-file> を渡すと
                            <file> と同じディレクトリの代わりにそれを重ねる
                            （共有は main の承認済みの版、local は本体の checkout
                            の版を重ねるときに使う）

local の上書き: 表は深く重ね、配列（use・models・priority.*.*・effort.raise）は
丸ごと置き換える。上書きできない項目（instance.review・effort.option・assign_label・
担当 id の追加・他の開発者の表・知らない最上位キー・共有の toml に無い条件名）は、
「<file>: warning: <キー>: <理由>」を標準エラーに出して無視する。
警告と検証エラーには値を出さず、キー名と理由だけを出す（effective の JSON
には重ねた結果の値が出る）。
EOF
  exit 0
}

case "${1:-}" in
  validate|slots|effective) ;;
  -h|--help) help ;;
  *) usage ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 -I - "$ROOT" "$@" <<'PY'
import copy, json, os, stat, sys, tomllib

root, argv = sys.argv[1], sys.argv[2:]
roles = ("implement", "investigate", "review")
known_agents = ("opencode", "devin", "codex", "claude")
LOCAL_NAME = "agent-team.local.toml"


def fail(msg, rc=1):
    sys.stderr.write(f"agent-team-config: {msg}\n")
    sys.exit(rc)


def load(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        fail(f"{path}: ファイルが無い", 2)
    except tomllib.TOMLDecodeError as e:
        fail(f"{path}: TOML として読めない（{e}）")
    except OSError as e:
        fail(f"{path}: 読めない（{e}）")


errors = []
warned = []
_emitted = 0
# 検証エラーに値を出してよいか。共有の toml の検証では出すが、local を重ねた結果の
# 検証では False にしてキー名と理由だけにする（local の値を標準エラーに出さない決まり）
show_values = True


def err(key, msg):
    errors.append(f"{key}: {msg}")


def warn(key, msg):
    # 警告はキー名と理由だけ（値は出さない）
    warned.append(f"{key}: {msg}")


def pos_int(v):
    # bool は TOML では int と別の型（Python の isinstance(True, int) は True なので型で見る）
    return type(v) is int and v >= 1


def str_list(key, v):
    if isinstance(v, list) and v and all(isinstance(x, str) and x for x in v):
        return True
    err(key, "空でない文字列の一覧が要る")
    return False


def capable(agent, wants):
    inst = agent.get("instance") if isinstance(agent, dict) else None
    return isinstance(inst, dict) and any(r in inst for r in wants)


def limit_table(key, t, use, agents, wants):
    if not isinstance(t, dict):
        err(key, "上限の表が要る")
        return
    seen = set()
    for name, v in t.items():
        k = f"{key}.{name}"
        if name not in known_agents:
            err(k, "登録情報に無い担当 id")
        elif name not in use:
            err(k, "この開発者の use に無い担当")
        elif not capable(agents.get(name), wants):
            err(k, "この役割を担わない担当に上限を書いている")
        if not pos_int(v):
            err(k, "上限は 1 以上の整数が要る")
        seen.add(name)
    for name in use:
        if capable(agents.get(name), wants) and name not in seen:
            err(f"{key}.{name}", "この役割を担う使える担当に上限が無い（無制限になるため要る）")


def check_agents(doc):
    agents = doc.get("agents")
    if not isinstance(agents, dict):
        err("agents", "担当の登録情報の表が要る")
        return {}
    for want in known_agents:
        if want not in agents:
            err(f"agents.{want}", "登録が無い")
    for name, a in agents.items():
        akey = f"agents.{name}"
        if name not in known_agents:
            err(akey, "登録情報に無い担当 id（id は opencode・devin・codex・claude の 4 種）")
            continue
        if not isinstance(a, dict):
            err(akey, "表が要る")
            continue
        inst = a.get("instance")
        if not isinstance(inst, dict) or not inst:
            err(f"{akey}.instance", "役割ごとの provider インスタンス名の表が要る")
        else:
            for r, v in inst.items():
                if r not in roles:
                    err(f"{akey}.instance.{r}", "役割は implement・investigate・review のどれか")
                elif not isinstance(v, str) or not v:
                    err(f"{akey}.instance.{r}", "空でない文字列が要る")
        str_list(f"{akey}.models", a.get("models"))
        eff = a.get("effort")
        if not isinstance(eff, dict):
            err(f"{akey}.effort", "表が要る")
        else:
            if not isinstance(eff.get("option"), str) or not eff.get("option"):
                err(f"{akey}.effort.option", "空でない文字列が要る")
            str_list(f"{akey}.effort.raise", eff.get("raise"))
        if not isinstance(a.get("assign_label"), str):
            err(f"{akey}.assign_label", "文字列が要る（付けないときは空文字）")
    return agents


def check_developers(doc, agents):
    devs = doc.get("developers")
    if not isinstance(devs, dict) or not devs:
        err("developers", "開発者の表が 1 つ以上要る")
        return
    for login, d in devs.items():
        dkey = f"developers.{login}"
        if not isinstance(d, dict):
            err(dkey, "表が要る")
            continue
        use = d.get("use")
        use_known = [n for n in (use if isinstance(use, list) else []) if n in known_agents]
        if str_list(f"{dkey}.use", use):
            for n in use:
                if n not in known_agents:
                    err(f"{dkey}.use", f"登録情報に無い担当 id: {n}" if show_values
                        else "登録情報に無い担当 id がある")
        if not any(capable(agents.get(n), ("implement",)) for n in use_known):
            err(f"{dkey}.use", "実装の役割を持つ担当が 1 つも無い")
        if not any(capable(agents.get(n), ("review",)) for n in use_known):
            err(f"{dkey}.use", "レビューの役割を持つ担当が 1 つも無い")
        use_set = set(use_known)
        limit_table(f"{dkey}.slots", d.get("slots"), use_known, agents,
                    ("implement", "investigate"))
        limit_table(f"{dkey}.review_limits", d.get("review_limits"), use_known,
                    agents, ("review",))
        prio = d.get("priority")
        if not isinstance(prio, dict):
            err(f"{dkey}.priority", "条件ごとの優先順位の表が要る")
        else:
            for role in ("implement", "review"):
                if not isinstance(prio.get(role), dict) or not prio.get(role):
                    err(f"{dkey}.priority.{role}", "この役割の優先順位が要る")
            for role, conds in prio.items():
                rkey = f"{dkey}.priority.{role}"
                if role not in roles:
                    err(rkey, "役割は implement・investigate・review のどれか")
                    continue
                if not isinstance(conds, dict):
                    err(rkey, "条件名→担当の並びの表が要る")
                    continue
                for cond, lst in conds.items():
                    ckey = f"{rkey}.{cond}"
                    if not str_list(ckey, lst):
                        continue
                    for n in lst:
                        if n not in known_agents:
                            err(ckey, f"登録情報に無い担当 id: {n}" if show_values
                                      else "登録情報に無い担当 id がある")
                        elif n not in use_set:
                            err(ckey, f"この開発者の use に無い担当: {n}" if show_values
                                      else "この開発者の use に無い担当がある")
                        elif not capable(agents.get(n), (role,)):
                            err(ckey, f"{role} の役割を担わない担当: {n}" if show_values
                                      else f"{role} の役割を担わない担当がある")


# ── agent-team.local.toml の重ね合わせ ──────────────────────────────
# 上書きできる項目だけを共有の doc の上に重ねる。それ以外のキーは
# 警告を出して無視する（値は警告にも出力にも出さない）。
# login: 呼び出し側の開発者の login（slots・effective）。validate では None で、
# local の developers.<X> は共有の developers にある表だけをそれぞれ重ねる
# （「自分以外」を決める login が無いため、slots・effective 側の制限は掛けない）。

def merge_agents(doc, tbl):
    if not isinstance(tbl, dict):
        warn("agents", "表でない（無視）")
        return
    for name, a in tbl.items():
        key = f"agents.{name}"
        cur = doc.get("agents", {}).get(name)
        if cur is None:
            warn(key, "共有の toml に無い担当 id（追加は共有の toml の PR で。無視）")
            continue
        if not isinstance(a, dict):
            warn(key, "表でない（無視）")
            continue
        for k, v in a.items():
            kkey = f"{key}.{k}"
            if k == "models":
                cur["models"] = v  # 値の検証は重ねた結果に掛ける（型の誤りは止まる）
            elif k == "effort":
                merge_effort(cur, v, kkey)
            elif k == "instance":
                merge_instance(cur, v, kkey)
            else:  # assign_label と知らないキー
                warn(kkey, "上書きできない項目（無視）")


def merge_effort(agent, v, key):
    if not isinstance(v, dict):
        agent["effort"] = v
        return
    eff = agent.get("effort")
    if not isinstance(eff, dict):
        eff = {}
        agent["effort"] = eff
    for ek, ev in v.items():
        if ek == "raise":
            eff["raise"] = ev
        else:  # option と知らないキー
            warn(f"{key}.{ek}", "上書きできない項目（無視）")


def merge_instance(agent, v, key):
    if not isinstance(v, dict):
        agent["instance"] = v
        return
    inst = agent.get("instance")
    if not isinstance(inst, dict):
        inst = {}
        agent["instance"] = inst
    for ik, iv in v.items():
        # instance.review はレビューの隔離の前提（main の版と dev-environment.md の照合）のため
        # local では上書きできない。implement・investigate だけ開発者の環境に合わせられる
        if ik in ("implement", "investigate"):
            inst[ik] = iv
        else:
            warn(f"{key}.{ik}", "上書きできない項目（無視）")


def merge_developers(doc, tbl, login):
    if not isinstance(tbl, dict):
        warn("developers", "表でない（無視）")
        return
    for x, d in tbl.items():
        key = f"developers.{x}"
        if login is not None and x != login:
            warn(key, "自分以外の開発者の表は local に書けない（無視）")
            continue
        cur = doc.get("developers", {}).get(x)
        if cur is None:
            warn(key, "共有の toml に無い開発者の表（無視）")
            continue
        if not isinstance(d, dict):
            warn(key, "表でない（無視）")
            continue
        use_overridden = False
        local_names = {"slots": set(), "review_limits": set(), "priority": set()}
        for k, v in d.items():
            kkey = f"{key}.{k}"
            if k == "use":
                cur["use"] = v
                use_overridden = True
            elif k in ("slots", "review_limits"):
                merge_limit(cur, k, v)
                if isinstance(v, dict):
                    local_names[k] |= set(v)
            elif k == "priority":
                merge_priority(cur, v, kkey)
                if isinstance(v, dict):
                    for r, conds in v.items():
                        if isinstance(conds, dict):
                            local_names["priority"] |= {(r, c) for c in conds}
            else:
                warn(kkey, "上書きできない項目（無視）")
        if use_overridden:
            cascade_use(cur, key, local_names)


def cascade_use(dev, key, local_names):
    """use が丸ごと置き換わったあと、新しい use に無い担当への参照を
    重ねた結果から落とす（上限・優先順位に残ると検証で止まり、
    「使えない担当を外す」という本来の上書きが書けなくなる）。
    落とすのは共有から継いだ項目だけで、local が明示した項目は残して
    検証にかける（黙って消すと誤った設定を見逃す）。落とした項目は
    キー名つきで警告する。"""
    use = dev.get("use")
    keep = {n for n in use if isinstance(n, str)} if isinstance(use, list) else set()
    for k in ("slots", "review_limits"):
        t = dev.get(k)
        if isinstance(t, dict):
            for name in [n for n in t
                         if n not in keep and n not in local_names[k]]:
                del t[name]
                warn(f"{key}.{k}.{name}", "新しい use に無い担当の項目を落とす")
    prio = dev.get("priority")
    if isinstance(prio, dict):
        for role, conds in prio.items():
            if not isinstance(conds, dict):
                continue
            for cond, lst in conds.items():
                if (role, cond) in local_names["priority"] or \
                        not isinstance(lst, list):
                    continue
                kept = [n for n in lst if isinstance(n, str) and n in keep]
                if kept != lst:
                    conds[cond] = kept
                    warn(f"{key}.priority.{role}.{cond}",
                         "新しい use に無い担当を並びから落とす")


def merge_limit(dev, k, v):
    if not isinstance(v, dict):
        dev[k] = v
        return
    cur = dev.get(k)
    if not isinstance(cur, dict):
        cur = {}
        dev[k] = cur
    for name, lim in v.items():
        cur[name] = lim


def merge_priority(dev, v, key):
    if not isinstance(v, dict):
        dev["priority"] = v
        return
    cur = dev.get("priority")
    if not isinstance(cur, dict):
        cur = {}
        dev["priority"] = cur
    for role, conds in v.items():
        rkey = f"{key}.{role}"
        if role not in roles:
            warn(rkey, "役割は implement・investigate・review のどれか（無視）")
            continue
        if not isinstance(cur.get(role), dict):
            warn(rkey, "共有の toml に無い役割（無視）")
            continue
        if not isinstance(conds, dict):
            cur[role] = conds  # 型の誤りは検証で止まる
            continue
        for cond, lst in conds.items():
            ckey = f"{rkey}.{cond}"
            if cond not in cur[role]:
                warn(ckey, "共有の toml に無い条件名（無視）")
                continue
            cur[role][cond] = lst


def warn_required(doc, logins):
    # 共有の規則で必須の役に当たる担当が使えなくなるときの警告（Issue #804 の未決事項。
    # 扱いは実装役が needs-decision で指揮役に上げる）。値ではなくキー名と理由だけを出す
    for login in logins:
        d = doc.get("developers", {}).get(login)
        if not isinstance(d, dict):
            continue
        # 型の合わない値（use が list でない、priority/review が dict でない）は
        # 後続の validate_doc がキー名つきで止めるため、ここでは読まずに警告を飛ばす
        use = d.get("use") or []
        if not isinstance(use, list):
            continue
        if "codex" not in use:
            warn(f"developers.{login}.use",
                 "codex が使えないが、マージには現在の head への codex の有効な approve が要る"
                 "（共有の規則は local では下げられない。扱いは指揮役の needs-decision）")
        prio = d.get("priority")
        hr = prio.get("review") if isinstance(prio, dict) else None
        if isinstance(hr, dict):
            hr_list = hr.get("high_risk")
            if isinstance(hr_list, list) and not [n for n in hr_list if n in use]:
                warn(f"developers.{login}.priority.review.high_risk",
                     "use に入る高リスクのレビュー担当が無い"
                     "（Issue #804 の未決事項。扱いは指揮役の needs-decision）")


def emit_warnings(label):
    global _emitted
    for w in warned[_emitted:]:
        sys.stderr.write(f"{label}: warning: {w}\n")
    _emitted = len(warned)


def validate_doc(doc, label):
    agents = check_agents(doc)
    check_developers(doc, agents)
    if errors:
        for e in errors:
            sys.stderr.write(f"{label}: {e}\n")
        sys.exit(1)


def open_local(path):
    """local をリンクをたどらずに開き、通常ファイルのときだけ読み込み用の
    ファイルオブジェクトを返す（無ければ None、symlink や通常ファイルで
    ないものは False）。開く操作自体でリンクを拒否し、開いた fd が
    通常ファイルか確かめるため、確認と読み込みの間に置き換わる経路が無い"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError:
        return False
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            return False
        return os.fdopen(fd, "rb")
    except OSError:
        os.close(fd)
        return False


def load_local_fd(fobj, label):
    try:
        return tomllib.load(fobj)
    except tomllib.TOMLDecodeError as e:
        fail(f"{label}: TOML として読めない（{e}）")


def load_effective(path, login, lpath=None):
    """共有の toml を検証し、local（あれば）を重ねて重ねた結果を検証して返す。
    local が無ければ共有の doc をそのまま返す（従来どおり）。login は slots・effective の
    呼び出し側の開発者（自分以外の表は無視）。validate では None。
    lpath を渡すと <file> と同じディレクトリの代わりにそのパスを local として読む"""
    doc = load(path)
    validate_doc(doc, path)
    if lpath is None:
        lpath = os.path.join(os.path.dirname(os.path.abspath(path)), LOCAL_NAME)
    lf = open_local(lpath)
    if lf is not None and lf is not False:
        pass
    else:
        if lf is False or os.path.lexists(lpath):
            # symlink（本体以外のファイルを指しうる）や通常ファイルでないものは
            # 重ねず、理由だけ警告する
            warn(LOCAL_NAME, "symlink か通常ファイルでないため重ねない")
            emit_warnings(lpath)
        return doc
    local = load_local_fd(lf, lpath)
    merged = merge_local(copy.deepcopy(doc), local, login)
    emit_warnings(lpath)
    # 必須の役に当たる担当不足の警告は検証より先に出す（検証で止まる場合にも
    # needs-decision へ引き継げる根拠を残す）
    warn_required(merged, [login] if login is not None else
                  [x for x in merged.get("developers", {})])
    emit_warnings(lpath)
    # local の値をエラーに出さない（キー名と理由だけ）
    global show_values
    show_values = False
    validate_doc(merged, f"{path} (+{LOCAL_NAME})")
    show_values = True
    return merged


def merge_local(doc, local, login):
    for top, tv in local.items():
        if top == "agents":
            merge_agents(doc, tv)
        elif top == "developers":
            merge_developers(doc, tv, login)
        else:
            warn(top, "local に書けない最上位キー（無視）")
    return doc


def do_validate(path):
    load_effective(path, None)
    print(f"agent-team-config: ok {path}")


def do_slots(login, path):
    # 読み出しも検証を共有する。違反があれば標準出力には何も出さずに非 0 で止まる。
    doc = load_effective(path, login)
    devs = doc.get("developers", {})
    if not isinstance(devs.get(login), dict):
        fail(f"{path}: developers.{login} の表が無い")
    for name, v in devs[login]["slots"].items():
        print(f"{name} {v}")


def do_effective(login, path, lpath=None):
    doc = load_effective(path, login, lpath)
    devs = doc.get("developers", {})
    if not isinstance(devs.get(login), dict):
        fail(f"{path}: developers.{login} の表が無い")
    print(json.dumps({"agents": doc.get("agents", {}),
                      "developers": {login: devs[login]}},
                     ensure_ascii=False, indent=2, sort_keys=True))


mode = argv[0]
if mode == "validate":
    if len(argv) > 2:
        sys.stderr.write("usage: agent-team-config validate [<file>]\n")
        sys.exit(2)
    do_validate(argv[1] if len(argv) == 2 else f"{root}/agent-team.toml")
elif mode == "slots":
    if len(argv) not in (2, 3):
        sys.stderr.write("usage: agent-team-config slots <login> [<file>]\n")
        sys.exit(2)
    do_slots(argv[1], argv[2] if len(argv) == 3 else f"{root}/agent-team.toml")
elif mode == "effective":
    if len(argv) not in (2, 3, 4):
        sys.stderr.write("usage: agent-team-config effective <login> [<file> [<local-file>]]\n")
        sys.exit(2)
    do_effective(argv[1],
                 argv[2] if len(argv) >= 3 else f"{root}/agent-team.toml",
                 argv[3] if len(argv) == 4 else None)
PY
