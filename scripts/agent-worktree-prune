#!/usr/bin/env bash
# T3 が作った worktree のうち、仕事が終わったものを消す。
#
# 使い方: scripts/agent-worktree-prune [--dry-run | --yes | --auto]
#   既定は一覧を見せてから y/N で確認する。--dry-run は一覧だけ、--yes は確認せずに消す。
#   --auto は pitchfork の定期実行（pitchfork.toml の agent-worktree-prune）用。確認せずに消し、
#   未追跡のファイルしか残っていない worktree もファイルごと消し、最後に後片付け
#   （git worktree prune・git fetch --prune origin・mbx gc）を走らせる。
#
# 対象は $PELWAY_T3_WORKTREES（既定 ~/.t3/worktrees/Pelway）の下の worktree だけ。
# 次の worktree は作業中として残す。
#   - settle されていない T3 スレッドの worktree（t3 thread show の worktreePath）
#   - 生きているプロセスのカレントディレクトリ（/proc/<pid>/cwd）が中にある worktree
#     （t3 thread list に出ない delegate_task の子スレッドの worktree を守る。消す直前にもう一度確かめる）
#   - 最後の変更（作業ツリーと、git dir の HEAD・index の更新時刻のうち新しいもの）から 6 時間以内の worktree
# T3 に問い合わせられないとき、/proc を読めないときは何も消さずに失敗する。それ以外で消すのは次のどれか。
#   - HEAD が origin/main に取り込まれている → worktree とブランチを消す
#   - ブランチの PR がマージ済み → worktree とブランチを消す
#   - ブランチの PR が閉じている（開いている PR が無い） → worktree だけ消し、ブランチは残す
# 変更が残っている worktree は消さない（旧通知プラグイン .opencode/plugins/pelway-agent-notify.ts だけは変更と数えない）。
# --auto では未追跡のファイルは変更と数えず、追跡ファイルの変更だけを数える。
set -uo pipefail

ROOT="${PELWAY_T3_WORKTREES:-$HOME/.t3/worktrees/Pelway}"
PLUGIN=".opencode/plugins/pelway-agent-notify.ts"
mode=ask
case "${1:-}" in
  --dry-run) mode=dry ;;
  --yes) mode=yes ;;
  --auto) mode=auto ;;
  "") ;;
  *) echo "usage: agent-worktree-prune [--dry-run | --yes | --auto]" >&2; exit 2 ;;
esac
if [[ "$mode" == auto ]]; then
  # pitchfork の supervisor は各 worktree の pitchfork.toml の cron も動かすので、
  # main の checkout 以外（linked worktree）からの --auto は何もせずに終える。
  if [[ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]]; then
    echo "agent-worktree-prune: --auto は main の checkout でだけ動く（ここは linked worktree）。何もしない"
    exit 0
  fi
  # 同時に 2 つ走らせない
  lock="${XDG_STATE_HOME:-$HOME/.local/state}/pelway/agent-worktree-prune.lock"
  mkdir -p "$(dirname "$lock")"
  exec 9>"$lock"
  flock -n 9 || { echo "agent-worktree-prune: 別の --auto が実行中。何もしない"; exit 0; }
  # 裏に残りうる子（git の自動 gc・mbx など）にロックの fd を渡さない（下の 9>&-）
  echo "== agent-worktree-prune --auto $(date -Iseconds)"
fi

# t3 CLI の解決は scripts/conductor-watch.sh と同じ（実行中の T3 サーバーと同じ実行ファイルを優先する）。
# T3_BIN 環境変数で明示したときは解決しない（テストの差し替えに使う）。
T3_BIN="${T3_BIN:-}"
if [[ -z "$T3_BIN" ]]; then
  T3_BIN="$(command -v t3 || true)"
  for exe in /proc/[0-9]*/exe; do
    link="$(readlink "$exe" 2>/dev/null || true)"
    case "$link" in
      */.t3/wsl-runtime/*/t3) T3_BIN="$link"; break ;;
    esac
  done
fi
[[ -n "$T3_BIN" ]] || { echo "agent-worktree-prune: t3 が見つからない。何も消さない" >&2; exit 1; }

# settle されていないスレッドの worktree を集める（1 つでも読めなければ何も消さない）
threads="$("$T3_BIN" thread list --json 9>&-)" || { echo "agent-worktree-prune: t3 thread list に失敗した。何も消さない" >&2; exit 1; }
ids="$(jq -r '.[] | select(.settled != true) | .threadId' <<<"$threads")" || { echo "agent-worktree-prune: スレッド一覧を読めない。何も消さない" >&2; exit 1; }
busy=""
for id in $ids; do
  show="$("$T3_BIN" thread show "$id" --json 9>&-)" || { echo "agent-worktree-prune: t3 thread show $id に失敗した。何も消さない" >&2; exit 1; }
  wt="$(jq -r '.thread.worktreePath // empty' <<<"$show")" || { echo "agent-worktree-prune: スレッド $id を読めない。何も消さない" >&2; exit 1; }
  [[ -n "$wt" ]] && busy+="$wt"$'\n'
done

# プロセスのカレントディレクトリを集める（「pid<TAB>コマンド名<TAB>cwd」の行。他人のプロセスは読めないので飛ばす）
readlink /proc/self/cwd >/dev/null 2>&1 || { echo "agent-worktree-prune: /proc を読めない。何も消さない" >&2; exit 1; }
collect_cwds() {
  cwds=""
  local d cwd comm
  for d in /proc/[0-9]*; do
    cwd="$(readlink "$d/cwd" 2>/dev/null)" || continue
    comm="$(<"$d/comm")" 2>/dev/null || continue
    cwds+="${d#/proc/}"$'\t'"$comm"$'\t'"$cwd"$'\n'
  done
}
collect_cwds
recent_since="$(date -d '6 hours ago' +%s)"

live_process() { # worktree の中にカレントディレクトリがあるプロセスの「pid N コマンド名」。無ければ空
  awk -F '\t' -v p="$1" '$3 == p || index($3, p "/") == 1 { print "pid " $1 " " $2; exit }' <<<"$cwds"
}

recently_updated() { # 作業ツリー（.git を除く）か git dir の HEAD・index が 6 時間以内に変わったか
  local gitdir f
  gitdir="$(git -C "$1" rev-parse --absolute-git-dir)" || return 0
  for f in "$gitdir/HEAD" "$gitdir/index"; do
    [[ -e "$f" ]] && (($(stat -c %Y "$f") >= recent_since)) && return 0
  done
  [[ -n "$(find "$1" -xdev -path "$1/.git" -prune -o -newermt "@$recent_since" -print -quit)" ]]
}

git fetch --quiet origin main 9>&- || { echo "agent-worktree-prune: git fetch に失敗した" >&2; exit 1; }
prs="$(gh pr list --state all --limit 1000 --json headRefName,state 9>&-)" || { echo "agent-worktree-prune: gh pr list に失敗した" >&2; exit 1; }

pr_state() { # ブランチの PR の状態: OPEN が 1 つでもあれば OPEN、次に MERGED、次に CLOSED、無ければ空
  local b="$1" states
  states="$(jq -r --arg b "$b" '.[] | select(.headRefName == $b) | .state' <<<"$prs")"
  for s in OPEN MERGED CLOSED; do grep -qx "$s" <<<"$states" && { echo "$s"; return; }; done
}

changes() { # 変更と数える git status の行（--auto では未追跡を除く）
  local lines
  lines="$(git -C "$1" status --porcelain --untracked-files=all | grep -v -F " $PLUGIN")"
  [[ "$mode" == auto ]] && lines="$(grep -v '^??' <<<"$lines")"
  printf '%s' "$lines"
}

remove=() delete_branch=() keep=()
declare -A branch_of
while read -r path branch; do
  [[ "$path" == "$ROOT"/* ]] || continue
  branch="${branch#refs/heads/}"
  if grep -qxF "$path" <<<"$busy"; then keep+=("$path (settle されていないスレッドの worktree)"); continue; fi
  proc="$(live_process "$path")"
  if [[ -n "$proc" ]]; then keep+=("$path (プロセスが動いている: $proc)"); continue; fi
  # changes の git status が index を書き換えうるので、更新時刻はその前に測る
  if recently_updated "$path"; then keep+=("$path (6 時間以内に更新された)"); continue; fi
  if [[ -n "$(changes "$path")" ]]; then keep+=("$path (変更が残っている)"); continue; fi
  head="$(git -C "$path" rev-parse HEAD)"
  state=""
  [[ "$branch" != DETACHED ]] && state="$(pr_state "$branch")"
  if [[ "$state" == OPEN ]]; then
    keep+=("$path (開いている PR がある)")
  elif git merge-base --is-ancestor "$head" origin/main || [[ "$state" == MERGED ]]; then
    remove+=("$path")
    [[ "$branch" != DETACHED ]] && { delete_branch+=("$branch"); branch_of[$path]="$branch"; }
  elif [[ "$state" == CLOSED ]]; then
    remove+=("$path")
  else
    keep+=("$path (main に未取り込みで PR も無い)")
  fi
done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w" "$2} /^detached/{print w" DETACHED"}')

printf '消す worktree: %d\n' "${#remove[@]}"
for p in "${remove[@]}"; do printf '  %s\n' "$p"; done
printf '消すブランチ: %d\n' "${#delete_branch[@]}"
for b in "${delete_branch[@]}"; do printf '  %s\n' "$b"; done
printf '残す worktree: %d\n' "${#keep[@]}"
for p in "${keep[@]}"; do printf '  %s\n' "$p"; done

[[ "$mode" == dry ]] && exit 0
if [[ "$mode" == ask && ${#remove[@]} -gt 0 ]]; then
  read -r -p "消しますか？ [y/N] " ans
  [[ "$ans" == y || "$ans" == Y ]] || { echo "何もしなかった"; exit 0; }
fi

status=0
for p in "${remove[@]}"; do
  # 一覧を作った後（確認の質問の間など）に始まったプロセスを、消す直前に見直す
  collect_cwds
  proc="$(live_process "$p")"
  if [[ -n "$proc" ]]; then echo "残した: $p (プロセスが動いている: $proc)"; continue; fi
  rm -f "$p/$PLUGIN"
  if [[ "$mode" == auto ]]; then
    git worktree remove --force "$p" 9>&- || { echo "失敗: $p" >&2; status=1; continue; }
  else
    git worktree remove "$p" || { echo "失敗: $p" >&2; status=1; continue; }
  fi
  b="${branch_of[$p]:-}"
  [[ -n "$b" ]] && { git branch -D "$b" >/dev/null || { echo "失敗: ブランチ $b" >&2; status=1; }; }
done

if [[ "$mode" == auto ]]; then
  # 後片付け。1 つが失敗しても残りは続け、失敗は終了コードに反映する。
  git worktree prune || { echo "失敗: git worktree prune" >&2; status=1; }
  git fetch --quiet --prune origin 9>&- || { echo "失敗: git fetch --prune origin" >&2; status=1; }
  mbx gc 9>&- || { echo "失敗: mbx gc" >&2; status=1; }
fi
exit "$status"
