#!/usr/bin/env bash
# agent-gh の push の verify ゲート（#807）。scripts/agent-gh の一時 pre-push フックから bash で呼ばれる。
# 印は一度だけ開いて木と verify-id を同じ内容から読み、開始の記録が同じ印の指紋を指すときは止める。
set -euo pipefail

# 印と木の比較で refs/replace の置き換えを使わない。Git は転送では置き換えを使わず本体を送るため。
export GIT_NO_REPLACE_OBJECTS=1

stop_unverified() {
  local reason="$1"
  echo "agent-gh: push を止めました: verify が通った木の印を確認できません（$reason）" >&2
  echo "agent-gh: mise run verify を成功させてから push してください。確かめずに通すときは PELWAY_AGENT_SKIP_VERIFY_GATE=1" >&2
  exit 1
}

verify_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
. "$verify_script_dir/agent-verify-paths.sh"

git_dir="" root="" marker_path="" marker="" marker_ready=0
read_marker() {
  ((marker_ready)) && return 0
  git_rev_path --git-dir || stop_unverified "gitdir を解決できません"
  physical_path "$REPLY" || stop_unverified "gitdir を絶対パスに解決できません"
  git_dir="$REPLY"
  git_rev_path --show-toplevel || stop_unverified "worktree のルートを解決できません"
  physical_path "$REPLY" || stop_unverified "worktree のルートを絶対パスに解決できません"
  root="$REPLY"
  marker_path="$git_dir/pelway-verify-tree"
  [[ -e "$marker_path" || -L "$marker_path" ]] || stop_unverified "印 $marker_path がありません"
  [[ -f "$marker_path" && ! -L "$marker_path" && -r "$marker_path" && -O "$marker_path" ]] ||
    stop_unverified "印 $marker_path が信頼できる通常ファイルではありません"
  stat_out="$(stat -c '%h %s %d:%i:%s:%Y' -- "$marker_path" 2>/dev/null)" || stop_unverified "印 $marker_path を確かめられません"
  links="${stat_out%% *}"; stat_rest="${stat_out#* }"; size="${stat_rest%% *}"; stat_key="${stat_rest#* }"
  [[ "$links" == 1 && ( "$size" == 84 || "$size" == 108 ) ]] || stop_unverified "印 $marker_path の形を判定できません"
  probe="$(mktemp "$git_dir/pelway-verify-write.XXXXXX" 2>/dev/null)" || stop_unverified "印を無効化できない状態です"
  rm -f -- "$probe" 2>/dev/null || stop_unverified "印を無効化できない状態です"
  # 木と verify-id は同じ一回の読み取りから取る。読み直しで別世代の行を混ぜない。
  marker_content="$(timeout 2 head -c 109 -- "$marker_path" 2>/dev/null && printf x)" || stop_unverified "印 $marker_path を読めません"
  marker_content="${marker_content%x}"
  [[ "$marker_content" == *$'\n'* ]] || stop_unverified "印 $marker_path の形を判定できません"
  marker="${marker_content%%$'\n'*}"
  rest="${marker_content#*$'\n'}"
  verify_id="${rest%$'\n'}"
  [[ "$rest" == "$verify_id"$'\n' && "$marker" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ && "$verify_id" =~ ^verify-id:[0-9a-f]{32}$ ]] ||
    stop_unverified "印 $marker_path の形を判定できません"
  marker_fp="$(printf '%s' "$marker_content" | sha256sum | cut -d' ' -f1)"
  stat_fp="$(printf 'stat:%s' "$stat_key" | sha256sum | cut -d' ' -f1)"
  control_dir="$root/.pelway-verify"; state_dir="$control_dir/started"
  control_mode="$(stat -c %a -- "$control_dir" 2>/dev/null)" || control_mode=""
  state_mode="$(stat -c %a -- "$state_dir" 2>/dev/null)" || state_mode=""
  [[ -d "$control_dir" && ! -L "$control_dir" && -O "$control_dir" && -d "$state_dir" && ! -L "$state_dir" && -O "$state_dir" && -r "$state_dir" && -x "$state_dir" && -n "$control_mode" && -n "$state_mode" ]] ||
    stop_unverified "verify の開始の記録が信頼できるディレクトリではありません"
  (( (8#$control_mode & 022) == 0 && (8#$state_mode & 022) == 0 )) ||
    stop_unverified "verify の開始の記録が信頼できるディレクトリではありません"
  shopt -s nullglob
  for start_file in "$state_dir"/*; do
    base="${start_file##*/}"
    target="${base%%.*}"
    attempt="${base#*.}"
    [[ ( "$target" == "$marker_fp" || "$target" == "$stat_fp" ) && "$attempt" =~ ^[0-9a-f]{32}$ ]] &&
      stop_unverified "前回の verify はこの印を無効化しました"
  done
  [[ "$(git --no-replace-objects cat-file -t "$marker" 2>/dev/null)" == tree ]] || stop_unverified "印の木 $marker を読めません"
  marker_ready=1
}

# 行を先に全部読む（比較のコマンドに、残りの入力を読ませないため）。
mapfile -t lines
for line in ${lines[@]+"${lines[@]}"}; do
  [[ -n "$line" ]] || continue
  read -r _lref lsha rref rsha extra <<<"$line"
  [[ -n "${rsha:-}" && -z "${extra:-}" && "$lsha" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || stop_unverified "pre-push の入力の行を判定できません（$line）"
  [[ "$lsha" =~ ^0+$ || "$rref" != refs/heads/* ]] && continue # 削除とブランチ以外は確かめない
  read_marker
  tree="$(git --no-replace-objects rev-parse -q --verify "$lsha^{tree}" 2>/dev/null)" ||
    stop_unverified "$rref へ送る $lsha の木を読めません"
  [[ "$tree" == "$marker" ]] && continue

  # 木どうしの差が docs/worklogs/ の下だけなら通す。ファイル名の空白や改行を壊さないよう NUL 区切りで読む。
  # rename 検出は外す。外のファイルを docs/worklogs/ の下へ移したときに移動先だけが出て、外の削除を見落とさないため。
  diff_out="$PELWAY_AGENT_HOOKS_DIR/verify-gate-diff.out"
  git --no-replace-objects diff-tree -r --no-renames --name-only -z "$marker" "$tree" >"$diff_out" 2>/dev/null ||
    stop_unverified "印の木と $rref へ送る木の差を読めません"
  only_worklogs=1 saw_diff=0
  while IFS= read -r -d '' path; do
    saw_diff=1
    case "$path" in
      docs/worklogs/*) ;;
      *) only_worklogs=0; break ;;
    esac
  done <"$diff_out"
  ((only_worklogs && saw_diff)) && continue
  stop_unverified "$rref へ送る木が印の木と違い、差は docs/worklogs/ の下だけではありません"
done
