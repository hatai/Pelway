#!/usr/bin/env bash
# agent-sandbox: T3 実装スレッド用の OS レベル sandbox（Issue #151）。
# bwrap で「worktree と必要なキャッシュだけ書き込み可、他は read-only」
# の mount 名前空間を作り、その中でコマンドを実行する。
#
# 呼び出し方:
#   sandbox-shell -c 'command'        opencode の shell フック経由（シェルとして起動される）
#   sandbox-shell --wrap -- cmd args  devin などのプロセスごと包む（devin-impl が使う）
#
# 設計上の性質:
#   - ネットワークはホスト共有（遮断しない。Issue #151 で hatai が許可リスト
#     非採用を指示したため）
#   - bwrap は no-new-privileges を設定するため sudo/doas/pkexec は使えない
#   - worktree 内の opencode.json[c]/.opencode/.devin はマスクし、sandbox
#     自体を無効化する設定改変を防ぐ
#   - 共有 git dir（worktree の commondir）はコミットのため書き込み可だが、
#     config と hooks/ は read-only に重ねてマウントする

set -euo pipefail

mode=shell
if [[ "${1:-}" == "--wrap" ]]; then
  mode=wrap
  shift
  [[ "${1:-}" == "--" ]] && shift
fi

home="$HOME"

# sandbox 内の書き込みルート。opencode プラグインは PELWAY_SBX_ROOT を
# 渡す。未指定なら git の toplevel、非 git ディレクトリなら cwd。
root="${PELWAY_SBX_ROOT:-}"
if [[ -z "$root" ]]; then
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
fi
root="$(cd "$root" && pwd -P)"

# bwrap マウント引数を組み立てる。失敗しても非 sandbox で動かさない
# （fail-closed）ため、途中で落ちたらそのまま終了する。
# / 全体ではなく必要な top-level だけを read-only で明示マウントする:
# --ro-bind / は /mnt/c 等の submount までミラーしてしまい、Windows 側
# ファイルが見える問題があった（Issue #98 の再現防止）。
args=(
  --die-with-parent --new-session
  --dev /dev --proc /proc --tmpfs /dev/shm
  --ro-bind /usr /usr
  --ro-bind /etc /etc
  --ro-bind /home /home
)
for d in /bin /sbin /lib /lib64 /lib32 /libx32 /opt /var /run /srv /boot; do
  if [[ -L "$d" ]]; then
    args+=(--symlink "$(readlink "$d")" "$d")
  elif [[ -d "$d" ]]; then
    args+=(--ro-bind "$d" "$d")
  fi
done

# mbx（mr_boxington）のハードリンクキャッシュ経由で共有オブジェクトを
# 書き換える事故を防ぐため、sandbox 内では mbx を無効化し、worktree の
# target シンボリックリンクを実ディレクトリに戻す。
if [[ -L "$root/target" ]]; then
  rm -f "$root/target"
  mkdir -p "$root/target"
fi

# 書き込み可: /tmp。広い bind は狭い bind より先に置く必要がある
# （後から親を bind すると、先に置いた子の ro-bind が無効化される
# bwrap の挙動を実機で確認済み）。
args+=(--bind /tmp /tmp)

# 書き込み可: セッションの worktree
args+=(--bind "$root" "$root")

# 書き込み可: 共有 git dir（コミットに必要）。config と hooks/ には
# read-only を重ねてマウントし、url rewrite や hook 設置を防ぐ。
if common="$(git -C "$root" rev-parse --git-common-dir 2>/dev/null)"; then
  common="$(cd "$common" && pwd -P)"
  if [[ "$common" != "$root"/* ]]; then
    args+=(--bind "$common" "$common")
  fi
  for f in config config.worktree; do
    if [[ -f "$common/$f" && ! -L "$common/$f" ]]; then
      args+=(--ro-bind "$common/$f" "$common/$f")
    fi
  done
  if [[ -d "$common/hooks" && ! -L "$common/hooks" ]]; then
    args+=(--ro-bind "$common/hooks" "$common/hooks")
  fi
fi

# 書き込み可: ツールキャッシュ
tool_dirs=(
  "$home/.cargo" "$home/.rustup"
  "$home/.local/share/mise" "$home/.local/state/mise"
  "$home/.cache/mise" "$home/.cache/pkl" "$home/.pkl"
  "$home/.npm" "$home/.cache/fnox"
)
if [[ "$mode" == wrap ]]; then
  # devin-impl: devin プロセス自身がログ・セッション・設定を書く。
  # credentials.toml と --config のファイルは atomic write（同じ
  # ディレクトリへの一時ファイル作成→rename）で更新されるため、親
  # ディレクトリごと書き込み可にする必要がある。permissions は補助層で、
  # これらが書き換わっても mount 境界は変わらない。
  mkdir -p "$home/.local/share/devin" \
    "$home/.config/devin/cli" "$home/.config/devin-impl" "$home/.cache/devin"
  tool_dirs+=(
    "$home/.local/share/devin"
    "$home/.config/devin/cli" "$home/.config/devin-impl" "$home/.cache/devin"
  )
fi
for d in "${tool_dirs[@]}"; do
  if [[ -d "$d" && ! -L "$d" ]]; then
    args+=(--bind "$d" "$d")
  fi
done
# 秘匿パスを tmpfs で隠す。symlink はマウントできないので実体を解決して隠す
# （~/.aws → /mnt/... のような symlink は /mnt 自体がマウントされないため
# 既に到達不能で、マスク対象外とする）。
masks=(
  "$home/.ssh" "$home/.gnupg" "$home/.docker" "$home/.kube" "$home/.aws"
  "$home/.config/gh" "$home/.config/opencode" "$home/.config/devin"
  "$home/.local/share/devin" "$home/.t3/userdata"
)
for m in "${masks[@]}"; do
  target="$m"
  if [[ -L "$target" ]]; then
    target="$(readlink -f "$target" 2>/dev/null || true)"
  fi
  [[ "$target" == "$home"/* ]] || continue
  # 実体が無いパスは隠すものが無いのでスキップ（ro な親には作れず
  # bwrap が失敗するため必須）。
  [[ -d "$target" || -f "$target" ]] || continue
  if [[ "$mode" == wrap ]]; then
    case "$target" in
      "$home/.config/devin"|"$home/.local/share/devin") continue ;;
    esac
  fi
  args+=(--tmpfs "$target")
done

# worktree 内で sandbox を無効化し得る設定面を塞ぐ。
# opencode.json[c]: "plugins": ["-pelway-sandbox"] による無効化を防ぐ。
# .opencode/.devin: 配下の設定ファイル作成自体を防ぐ。
empty_cfg="${XDG_RUNTIME_DIR:-/tmp}/pelway-sbx-empty.json"
[[ -f "$empty_cfg" ]] || printf '{}\n' >"$empty_cfg"
for f in opencode.json opencode.jsonc; do
  p="$root/$f"
  if [[ -f "$p" && ! -L "$p" ]]; then
    args+=(--ro-bind "$p" "$p")
  else
    args+=(--ro-bind "$empty_cfg" "$p")
  fi
done
for d in .opencode .devin; do
  p="$root/$d"
  if [[ -d "$p" && ! -L "$p" ]]; then
    args+=(--ro-bind "$p" "$p")
  else
    args+=(--tmpfs "$p")
  fi
done

# コマンド側が使わない T3 接続資格情報を落とす。
# --wrap 側（devin プロセス自身）は ACP/MCP 接続に必要なので落とさない。
env_args=(env)
if [[ "$mode" == shell ]]; then
  for v in T3_ACP_MCP_AUTHORIZATION T3_ACP_MCP_ENDPOINT T3_ACP_MCP_NODE \
           T3_ACP_MCP_ENTRYPOINT T3CODE_DESKTOP_HOST_SCOPE T3CODE_THREAD_ID; do
    env_args+=(-u "$v")
  done
fi
env_args+=(
  MISE_RUST_MR_BOXINGTON=0
  # .ssh を隠しているため git の SSH 署名は必ず失敗する。sandbox 内では
  # 署名を無効化する（push 後に scripts/agent-gh-resign が GitHub App 名義の
  # Verified 署名へ作り直すので問題ない）。
  GIT_CONFIG_COUNT=2
  GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false
  GIT_CONFIG_KEY_1=tag.gpgsign GIT_CONFIG_VALUE_1=false
)

if [[ "$mode" == wrap ]]; then
  exec bwrap "${args[@]}" -- "${env_args[@]}" "$@"
else
  # opencode は shell を `<shell> -c <command>` 形式で起動する
  exec bwrap "${args[@]}" -- "${env_args[@]}" bash "$@"
fi
