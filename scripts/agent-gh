#!/usr/bin/env bash
# エージェントの名義で gh / git を実行する。
#   scripts/agent-gh dev <gh の引数...>        実装担当 GitHub App pelway-dev
#   scripts/agent-gh review <gh の引数...>     レビュー担当 GitHub App pelway-review
#   scripts/agent-gh <dev|review> git <git の引数...>   その名義の認証で git を実行する
#   scripts/agent-gh -h | --help               使い方を標準出力に出して終了コード 0（fnox も gh も呼ばない）
# 呼ばれるたびに App のインストールトークン（1 時間有効）を発行し、GH_TOKEN として子プロセスにだけ渡す。画面には出さない。
# 終了コード: 2 = 役割の誤り、3 = トークンを取れない、それ以外は gh / git の終了コード（--help / -h は 0）
set -euo pipefail
# コマンド置換 $(...) の中でも set -e を効かせる（app_token 内の secret の失敗で止めるため）。
shopt -s inherit_errexit

# 値はリポジトリの fnox.toml ではなく、マシンごとの設定に age で暗号化して置く（scripts/setup/agent-accounts.sh が作る）。
fnox_config="${PELWAY_AGENT_FNOX_CONFIG:-$HOME/.config/pelway-agent/fnox.toml}"

usage() { echo "usage: $0 <dev|review> [git] <args...>" >&2; exit 2; }

# --help / -h の本体。使い方を標準出力に出して終了コード 0 で返る。
# builtin しか使わず fnox も gh も呼ばないので、PATH や認証情報が無い環境でも動く。
help() {
  printf '%s\n' \
    "usage: $0 <dev|review> [git] <args...>" \
    "" \
    "エージェントの名義で gh / git を実行する。" \
    "  $0 dev <gh の引数...>               実装担当 GitHub App pelway-dev" \
    "  $0 review <gh の引数...>            レビュー担当 GitHub App pelway-review" \
    "  $0 <dev|review> git <git の引数...>  その名義の認証で git を実行する" \
    "  $0 -h | --help                      この使い方を標準出力に出して終了する" \
    "" \
    "呼ばれるたびに App のインストールトークン（1 時間有効）を発行し、GH_TOKEN として子プロセスにだけ渡す。画面には出さない。" \
    "git push の成功後は scripts/agent-gh-resign がコミットを GitHub API の署名付きに付け替える（止めるときは PELWAY_AGENT_SKIP_RESIGN=1）。" \
    "終了コード: 2 = 役割の誤り、3 = トークンを取れない、4 = 署名の付け替えに失敗、それ以外は gh / git の終了コード"
  exit 0
}

secret() {
  local value
  if ! value="$(fnox -c "$fnox_config" get "$1" 2>/dev/null)" || [[ -z "$value" ]]; then
    echo "agent-gh: $fnox_config から $1 を取れません（scripts/setup/agent-accounts.sh で登録する）" >&2
    exit 3
  fi
  printf '%s' "$value"
}

# app_token <PREFIX>: fnox の <PREFIX>_APP_ID / _APP_INSTALLATION_ID / _APP_KEY から
# GitHub App のインストールトークンを発行して出力する。
app_token() {
  local app_id installation_id key key_file response token
  app_id="$(secret "$1_APP_ID")"
  installation_id="$(secret "$1_APP_INSTALLATION_ID")"
  key="$(secret "$1_APP_KEY")"
  # 秘密鍵は argv（ps で見える）に載せず、所有者だけが読める一時ファイルで渡し、使ったらすぐ消す。
  key_file="$(mktemp)"
  trap 'rm -f "${key_file:-}"' EXIT
  chmod 600 "$key_file"
  printf '%s\n' "$key" >"$key_file"
  # gh 拡張 Link-/gh-token。出力は JSON（{"token": "...", ...}）。
  if ! response="$(gh token generate --app-id "$app_id" --installation-id "$installation_id" --key "$key_file" 2>/dev/null)"; then
    rm -f "$key_file"
    echo "agent-gh: GitHub App のトークンを発行できません（gh extension install Link-/gh-token が必要）" >&2
    exit 3
  fi
  rm -f "$key_file"
  token="$(sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$response")"
  [[ -n "$token" ]] || { echo "agent-gh: トークン発行の応答に token がありません" >&2; exit 3; }
  printf '%s' "$token"
}

(($# >= 1)) || usage
role="$1"
shift

git_identity=()
case "$role" in
  dev)
    token="$(app_token PELWAY_DEV)"
    email="$(secret PELWAY_DEV_GIT_EMAIL)"
    git_identity=(-c "user.name=pelway-dev[bot]" -c "user.email=$email")
    ;;
  review)
    token="$(app_token PELWAY_REVIEW)"
    ;;
  -h|--help)
    help
    ;;
  *) usage ;;
esac

if [[ "${1:-}" == "git" ]]; then
  shift
  # origin が SSH（git@github.com:）だと credential helper は使われず、hatai の SSH 鍵で認証される。
  # GitHub への URL を HTTPS に書き換え、GH_TOKEN の名義で認証させる。
  # commit.gpgsign=false: 環境の署名設定（hatai の鍵）が App 名義のコミットに混ざるのを防ぐ。
  # 署名は push 後に agent-gh-resign が GitHub API で付け直す（GitHub App の Verified 署名）。
  git_cfg=("${git_identity[@]}" -c commit.gpgsign=false)
  for kind in insteadOf pushInsteadOf; do
    git_cfg+=(-c "url.https://github.com/.$kind=git@github.com:" -c "url.https://github.com/.$kind=ssh://git@github.com/")
  done
  git_cfg+=(-c credential.helper= -c 'credential.helper=!gh auth git-credential')

  if [[ "${1:-}" == "push" && -z "${PELWAY_AGENT_SKIP_RESIGN:-}" ]]; then
    rc=0
    GH_TOKEN="$token" git "${git_cfg[@]}" "$@" || rc=$?
    if ((rc == 0)); then
      if ! GH_TOKEN="$token" bash "$(cd "$(dirname "$0")" && pwd)/agent-gh-resign"; then
        echo "agent-gh: 署名付きコミットへの付け替えに失敗しました（push 自体は成功）。再度 push すると再試行されます。スキップは PELWAY_AGENT_SKIP_RESIGN=1" >&2
        exit 4
      fi
    fi
    exit "$rc"
  fi
  GH_TOKEN="$token" exec git "${git_cfg[@]}" "$@"
fi

GH_TOKEN="$token" exec gh "$@"
