#!/usr/bin/env bash
# エージェントの名義で gh / git を実行する。
#   scripts/agent-gh dev <gh の引数...>        実装担当 GitHub App pelway-dev
#   scripts/agent-gh review <gh の引数...>     レビュー担当 GitHub App pelway-review
#   scripts/agent-gh qa comment <番号> --body-file <path|->   QA 担当 GitHub App pelway-qa（この形だけ許可）
#   scripts/agent-gh <dev|review> git <git の引数...>   その名義の認証で git を実行する
#   scripts/agent-gh -h | --help               使い方を標準出力に出して終了コード 0（fnox も gh も呼ばない）
# 呼ばれるたびに App のインストールトークン（1 時間有効）を発行し、GH_TOKEN として子プロセスにだけ渡す。画面には出さない。
# gh は毎回空の一時 GH_CONFIG_DIR で呼ぶ。~/.config/gh や呼び出し元の GH_CONFIG_DIR（外部の hosts.yml）は
# 参照もフォールバックもさせない（#522。レビュー sandbox が ~/.config/gh を読めないのと、人間のトークンへの
# 黙ったフォールバックを防ぐため）。一時ディレクトリは終了時に消す。
# qa は許可リスト方式で、上の 1 形以外の呼び出し（ラベル・Approve・マージ・編集・削除など）はトークン発行前に終了コード 2 で拒否する。
# qa は dev / review と違い PELWAY_AGENT_FNOX_CONFIG に既定値を持たない（~/.config/pelway-agent-qa/fnox.toml を指す。未設定は終了コード 3）。
# dev 役の git push は、push の前に差分を scripts/pr-size.sh で測り、上限（追加 800 行・削除 2000 行）を
# 超えて例外（PR の pr-size-exception ラベル + Issue の hatai の目印コメント）が無ければ止める（#642）。
# 終了コード: 2 = 役割・引数の誤り（qa の許可外の呼び出しを含む）、3 = トークンを取れない（qa の PELWAY_AGENT_FNOX_CONFIG 未設定を含む）、4 = 署名の付け替えに失敗、5 = 引数に \uXXXX エスケープ混入、6 = dev 役の push で差分が pr-size の上限超え（例外なし）か、差分を測れない・Git が送る対象を検査できないため push を止めたとき、それ以外は gh / git の終了コード（--help / -h は 0）
set -euo pipefail
# コマンド置換 $(...) の中でも set -e を効かせる（app_token 内の secret の失敗で止めるため）。
shopt -s inherit_errexit

# 値はリポジトリの fnox.toml ではなく、マシンごとの設定に age で暗号化して置く（scripts/setup/agent-accounts.sh が作る）。
# dev と review で設定ファイルと age 鍵を分離する（#449）。review 用の設定には PELWAY_REVIEW_* だけが載り、
# review の sandbox からは dev 用の設定・age 鍵が読めない前提の構成。
fnox_config="${PELWAY_AGENT_FNOX_CONFIG:-$HOME/.config/pelway-agent/fnox.toml}"
review_fnox_config="${PELWAY_AGENT_FNOX_CONFIG_REVIEW:-$HOME/.config/pelway-agent-review/fnox.toml}"

usage() { echo "usage: $0 <dev|review> [git] <args...> | $0 qa comment <番号> --body-file <path|->" >&2; exit 2; }

# 終了時に消すパス（gh 隔離用の一時ディレクトリ）。呼び出しはすべて subshell の外で行う。
# app_token の秘密鍵一時ファイルはここに入れない: app_token は token="$(app_token ...)" の
# コマンド置換 subshell の中で動き、subshell では親の EXIT trap も cleanup_paths への追加も
# 親に届かないため、app_token 内で subshell 自身の trap を設定して消す（下を参照）。
cleanup_paths=()
cleanup() {
  local p
  for p in ${cleanup_paths[@]+"${cleanup_paths[@]}"}; do
    rm -rf -- "$p"
  done
}
trap cleanup EXIT

# gh を呼ぶ実行（dev / review / qa）では、gh に既定の ~/.config/gh や呼び出し元の GH_CONFIG_DIR
# （外部の hosts.yml）を絶対に参照させない（#522）。毎回空の一時ディレクトリで GH_CONFIG_DIR を
# 上書きし、終了時に cleanup で消す。GH_NO_UPDATE_NOTIFIER=1 も出す（gh が更新確認で設定
# ディレクトリとネットワークを使わないように）。exec で gh に置き換えると EXIT trap が走らない
# ため、gh / git の呼び出しは exec せず終了コードを渡す形にする（下の各呼び出しで exit）。
# gh のテレメトリ（cafe.github.com への送信）も GH_TELEMETRY=false と DO_NOT_TRACK=1 で止める（#527）。
# 空の GH_CONFIG_DIR では `gh config set telemetry disabled` が効かず、レビューの sandbox は
# cafe.github.com への通信を拒否して gh の実行ごと失敗させるため。
gh_isolated_config() {
  GH_CONFIG_DIR="$(mktemp -d)"
  GH_NO_UPDATE_NOTIFIER=1
  GH_TELEMETRY=false
  DO_NOT_TRACK=1
  export GH_CONFIG_DIR GH_NO_UPDATE_NOTIFIER GH_TELEMETRY DO_NOT_TRACK
  cleanup_paths+=("$GH_CONFIG_DIR")
}

# run_gh <gh の引数...>: GH_TOKEN を付けて gh を呼び、gh の終了コードを返す（#596）。
# gh 2.105 以降は、エージェントの環境（AI_AGENT・CLAUDECODE など）で pr view などを呼ぶと、
# stderr に `gh event listen` の案内（hint: で始まる 1 行と、字下げした続きの行）を毎回出す。
# 案内を消す環境変数・設定は無い（実測: gh 2.105.0。エージェントの検出に使う環境変数を外すと
# 消えるが、その一覧は gh の版で変わりうるうえ、gh の他の振る舞いも変える）。
# そこで stderr だけを絞り込みに通し、案内の塊だけを外す。案内は `hint: ... instead of polling:` の行の
# 次が `    gh event listen ` で始まるときだけと見なし（同じ書式の別の診断は残す）、その後に続く
# `  - ` の行までを外す。警告・エラーと、案内の塊が途切れた後の字下げした行はそのまま残す。
# stdout は絞り込みを通さない。
run_gh() {
  local st
  set +e
  { GH_TOKEN="$token" gh "$@" 2>&1 1>&3 3>&- | awk '
      held != "" {
        if (/^    gh event listen /) { held = ""; skip = 1; next }
        print held; held = ""
      }
      /^hint: .*instead of polling:$/ { held = $0; skip = 0; next }
      skip && /^  - / { next }
      { skip = 0; print; fflush() }
      END { if (held != "") print held }
    ' >&2; } 3>&1
  st=("${PIPESTATUS[@]}")
  set -e
  return "${st[0]}"
}

# qa の引数が `comment <番号> --body-file <path|->` の 1 形であることを確かめる。
# 許可リスト方式（#305 の案bと同じ考え方）で、それ以外の呼び出しはトークン発行前に終了コード 2 で拒否する。
qa_check_args() {
  if [[ "${1:-}" != "comment" || $# -ne 4 || "$3" != "--body-file" || ! "$2" =~ ^[0-9]+$ ]]; then
    echo "usage: $0 qa comment <番号> --body-file <path|->" >&2
    exit 2
  fi
  if [[ "$4" != "-" && ! -r "$4" ]]; then
    echo "agent-gh: --body-file のファイルを読めません" >&2
    exit 2
  fi
}

# --help / -h の本体。使い方を標準出力に出して終了コード 0 で返る。
# builtin しか使わず fnox も gh も呼ばないので、PATH や認証情報が無い環境でも動く。
help() {
  printf '%s\n' \
    "usage: $0 <dev|review> [git] <args...>" \
    "       $0 qa comment <番号> --body-file <path|->" \
    "" \
    "エージェントの名義で gh / git を実行する。" \
    "  $0 dev <gh の引数...>               実装担当 GitHub App pelway-dev" \
    "  $0 review <gh の引数...>            レビュー担当 GitHub App pelway-review" \
    "  $0 <dev|review> git <git の引数...>  その名義の認証で git を実行する" \
    "  $0 qa comment <番号> --body-file <path|->   QA 担当 GitHub App pelway-qa（この形だけ許可）" \
    "  $0 -h | --help                      この使い方を標準出力に出して終了する" \
    "" \
    "呼ばれるたびに App のインストールトークン（1 時間有効）を発行し、GH_TOKEN として子プロセスにだけ渡す。画面には出さない。" \
    "git push の成功後は scripts/agent-gh-resign がコミットを GitHub API の署名付きに付け替える（止めるときは PELWAY_AGENT_SKIP_RESIGN=1）。" \
    "qa は dev / review と違い PELWAY_AGENT_FNOX_CONFIG に既定値を持ちません（~/.config/pelway-agent-qa/fnox.toml を指してください）。" \
    "非 ASCII の文字列は argv 経由で渡せません（\\uXXXX に潰れます）。--body-file / api --input / git commit -F などファイル経由で渡してください。" \
    "終了コード: 2 = 役割・引数の誤り（qa の許可外の呼び出しを含む）、3 = トークンを取れない、4 = 署名の付け替えに失敗、5 = 引数に \\uXXXX エスケープ混入、6 = dev 役の push で差分が pr-size の上限超え（例外なし）か、差分を測れない・Git が送る対象を検査できないため push を止めたとき、それ以外は gh / git の終了コード"
  exit 0
}

secret() {
  local value
  if ! value="$(fnox -c "$fnox_config" get "$1" 2>/dev/null)" || [[ -z "$value" ]]; then
    echo "agent-gh: $fnox_config から $1 を取れません（scripts/setup/agent-accounts.sh で登録する）" >&2
    exit 3
  fi
  printf '%s' "$value"
}

# mask_secret_line <行> <伏せる値...>: 行内の秘密らしいものを伏せて出す（#520）。
# - 引数で渡された値そのもの（APP ID・INSTALLATION ID・秘密鍵の各行）
# - gh のトークンの形（ghp_ / gho_ / ghs_ など gh<英字 1 文字>_ の後ろに英数字が続く形）
# 秘密鍵は複数行の PEM で、 stderr の 1 行目に現れるのはその一部（1 行）のため、
# 呼び出し側で行ごとに分けて渡す（鍵全体を渡しても 1 行の中に一致しない）。
mask_secret_line() {
  local line="$1" v
  shift
  for v in "$@"; do
    [[ -n "$v" ]] || continue
    line="${line//"$v"/<秘密>}"
  done
  printf '%s' "$line" | sed -e 's/gh[a-zA-Z]_[A-Za-z0-9_]\{8,\}/gh?_<秘密>/g'
}

# app_token <APP ID の名前> <INSTALLATION ID の名前> <秘密鍵の名前>:
# fnox の 3 つの名前から GitHub App のインストールトークンを発行して出力する。
# 名前は役割ごとに違う（dev / review: PELWAY_*_APP_ID・_APP_INSTALLATION_ID・_APP_KEY、
# qa: PELWAY_QA_APP_ID・PELWAY_QA_INSTALLATION_ID・PELWAY_QA_PRIVATE_KEY）。
app_token() {
  # key_file・err_file は local にしない: EXIT trap の実行時には local 変数のスコープが既に
  # 終わっており ${key_file:-} が空に展開されるため、消すべきパスが trap に届かない。
  # グローバルなら subshell 内の trap から見える。
  local app_id installation_id key response token rc err_first ext_rc key_lines key_frags kl
  app_id="$(secret "$1")"
  installation_id="$(secret "$2")"
  key="$(secret "$3")"
  # 秘密鍵は argv（ps で見える）に載せず、所有者だけが読める一時ファイルで渡し、使ったらすぐ消す。
  # app_token は token="$(app_token ...)" のコマンド置換 subshell の中で動くため、親の
  # EXIT trap（cleanup）も cleanup_paths への追加もこの中では効かない（subshell の変更は
  # 親に届かない）。そこで subshell 自身の EXIT trap で消し、chmod・printf の失敗や割り込みで
  # 途中終了したときも鍵ファイルが残らないようにする。trap は subshell 内の設定なので
  # 親の cleanup と衝突しない。err_file（gh の stderr の取り込み用 #520）も同じ trap で消す。
  key_file="$(mktemp)"
  err_file="$(mktemp)"
  trap 'rm -f "${key_file:-}" "${err_file:-}"' EXIT
  chmod 600 "$key_file"
  printf '%s\n' "$key" >"$key_file"
  # gh 拡張 Link-/gh-token。出力は JSON（{"token": "...", ...}）。
  # 失敗のときは stderr を捨てず、1 行目を秘密を伏せて出す（#520）。
  rc=0
  response="$(gh token generate --app-id "$app_id" --installation-id "$installation_id" --key "$key_file" 2>"$err_file")" || rc=$?
  if ((rc != 0)); then
    rm -f "$key_file"
    err_first="$(head -n 1 "$err_file")"
    rm -f "$err_file"
    if [[ -n "$err_first" ]]; then
      # 秘密鍵（複数行の PEM）は行ごとに分けて伏せる値に渡す。BEGIN/END 行と空行は
      # それ自体秘密ではないため外す（stderr の 1 行に現れるのは鍵の一部の行）。
      mapfile -t key_lines <<<"$key"
      key_frags=()
      for kl in "${key_lines[@]}"; do
        [[ -z "$kl" || "$kl" == -----BEGIN* || "$kl" == -----END* ]] || key_frags+=("$kl")
      done
      echo "agent-gh: GitHub App のトークンを発行できません（gh token generate が失敗: $(mask_secret_line "$err_first" "$app_id" "$installation_id" "${key_frags[@]}")）" >&2
    else
      echo "agent-gh: GitHub App のトークンを発行できません（gh token generate が失敗、stderr なし・終了コード $rc）" >&2
    fi
    # 「拡張が必要」の文は、gh token --help が成功する（= gh-token 拡張が gh token
    # コマンドを提供している）ときは出さない。gh extension list は空の GH_CONFIG_DIR
    # （gh_isolated_config）では認証チェックに引っかかって常に失敗するため使えない
    # （cli/cli root.go の CheckAuth。実測: 空 GH_CONFIG_DIR で exit 4）。
    # gh token --help はヘルプ表示のため認証の門を通らない（実測 2026-11-20:
    # 拡張あり exit 0 / 拡張なし unknown command で exit 1 / gh 無し exit 127）。
    # 126/127 は bash 標準の「コマンドを起動できなかった」終了コードなので、
    # 「拡張が無い」とは別の案内を出す（誤った install 案内を防ぐ）。
    ext_rc=0
    gh token --help >/dev/null 2>&1 || ext_rc=$?
    if ((ext_rc == 126 || ext_rc == 127)); then
      echo "agent-gh: gh が起動できません（PATH を確認してください）" >&2
    elif ((ext_rc != 0)); then
      echo "agent-gh: gh extension install Link-/gh-token が必要です" >&2
    fi
    exit 3
  fi
  rm -f "$key_file" "$err_file"
  token="$(sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$response")"
  [[ -n "$token" ]] || { echo "agent-gh: トークン発行の応答に token がありません" >&2; exit 3; }
  printf '%s' "$token"
}

(($# >= 1)) || usage
role="$1"
shift

# argv 経由で届いた非 ASCII はハーネス層で \uXXXX に潰れていることがある。
# そのまま gh / git に流すと壊れた文字列が確定するので、トークン発行の前に止める。
# 引数の値は出さない（秘密が混入した引数を拒否経路で複製露出しないため）。番号だけを示す。
arg_i=0
for arg in "$@"; do
  arg_i=$((arg_i + 1))
  if [[ "$arg" == *\\u[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]* ]]; then
    echo "agent-gh: ${arg_i} 番目の引数に \\uXXXX のエスケープが残っています（非 ASCII は argv 経由で渡せません）" >&2
    echo "agent-gh: 文字列はファイル経由で渡してください（gh: --body-file / api --input、git: commit -F、タイトルは api -X PATCH --input）" >&2
    exit 5
  fi
done

# gh / git を呼ぶロールでは、gh の設定を空の一時ディレクトリに隔離する（#522）。
# -h / --help と役割の誤り（usage の exit 2）では何も作らない。
case "$role" in
  dev|review|qa) gh_isolated_config ;;
esac

git_identity=()
case "$role" in
  dev)
    token="$(app_token PELWAY_DEV_APP_ID PELWAY_DEV_APP_INSTALLATION_ID PELWAY_DEV_APP_KEY)"
    email="$(secret PELWAY_DEV_GIT_EMAIL)"
    git_identity=(-c "user.name=pelway-dev[bot]" -c "user.email=$email")
    ;;
  review)
    fnox_config="$review_fnox_config"
    token="$(app_token PELWAY_REVIEW_APP_ID PELWAY_REVIEW_APP_INSTALLATION_ID PELWAY_REVIEW_APP_KEY)"
    ;;
  qa)
    # 許可外の呼び出しは、fnox（秘密の読み出し）と gh（ネットワーク）のどちらよりも前に拒否する。
    qa_check_args "$@"
    # dev / review と違い既定値を持たない。未設定なら ~/.config/pelway-agent/fnox.toml
    # （dev 用の秘密）を読みに行かずに止める。
    if [[ -z "${PELWAY_AGENT_FNOX_CONFIG:-}" ]]; then
      echo "agent-gh: qa ロールは PELWAY_AGENT_FNOX_CONFIG が必要です（~/.config/pelway-agent-qa/fnox.toml を指してください）" >&2
      exit 3
    fi
    token="$(app_token PELWAY_QA_APP_ID PELWAY_QA_INSTALLATION_ID PELWAY_QA_PRIVATE_KEY)"
    # 送るのは POST /repos/hatai/Pelway/issues/<番号>/comments の 1 つだけ。
    # exec しない（EXIT trap で一時 GH_CONFIG_DIR を消すため）。終了コードは gh のものを返す。
    rc=0
    run_gh issue comment "$2" --repo hatai/Pelway --body-file "$4" || rc=$?
    exit "$rc"
    ;;
  -h|--help)
    help
    ;;
  *) usage ;;
esac

# push_targets 用: $1=-- と --no- と =<値> を除いたオプション名が $2=正規形と一致するか
# 判定する（$3=一意に特定できる最短の長さ）。長いオプションは一意な接頭辞で省略でき、
# それより短い形は他のオプションと曖昧で git が拒否するため届かない。
push_longopt() { ((${#1} >= $3)) && [[ "$2" == "$1"* ]]; }

# push_targets <git push の引数（push より後）...>: push 先から署名を付け直す対象を決める（#641）。
# 結果: push_remote と push_branches（ブランチ名の配列。重複なし）、push_srcs（push_branches と
# 対応する push 元の refspec の src）、push_fallback（1 なら
# agent-gh-resign を位置引数なしで呼び、resign が @{u} から対象を決める）、push_dry_run
# （1 なら試行で何も push されないため resign を呼ばない）、push_no_gate（1 なら pr-size の
# 検査自体をしない形: 削除・サブモジュールだけの push）。
# #642 の pr-size ゲートが pin した引数を組み立て直すために、引数の形も記録する:
#   push_raw（元の引数の配列）、push_pos_idx（位置引数が push_raw の何番目か）、
#   push_positional（位置引数。--repo が無ければ先頭はリモート、以降は refspec）、
#   push_expand_idx（--all / --branches の位置。pin のときは外し、解決した refspec に展開する）、
#   push_repo_opt / push_repo_value（--repo の有無と値。あるとき位置引数はすべて refspec）、
#   push_no_pin（1 なら <sha>:<dst> に pin できない形: --mirror・--prune・glob refspec）
# - refspec を省いた push、--all / --branches / --mirror / --tags / --prune / --repo、glob を含む refspec、
#   detached HEAD の HEAD は fallback（今までどおり）
# - 削除（:dst、-d / --delete）、サブモジュールだけを送る --recurse-submodules=only（push.recurseSubmodules=only の
#   設定を含む。後の指定や否定形で解除される）、ブランチ以外（refs/tags/ など refs/heads/ でない refs/）は対象にしない
# - src:dst は dst、コロンの無い refspec はそれ自身（HEAD は今のブランチ名）。先頭の + と refs/heads/ は除く
# - 長いオプションは一意に特定できる接頭辞で省略でき（--dr は --dry-run、--del は --delete）、
#   --no-<名> は直前の指定を戻す（-n --no-dry-run は実 push）。=<値> の連結は残りの引数を取らない
push_targets() {
  push_remote="" push_branches=() push_srcs=() push_fallback=0 push_dry_run=0 push_no_gate=0
  push_positional=() push_pos_idx=() push_expand_idx=() push_no_pin=0 push_repo_opt=0 push_repo_value=""
  push_raw=("$@")
  local delete=0 a spec src dst b seen i opt neg joined val submod_seen=0 submod_only=0 ai
  while (($#)); do
    a="$1"
    shift
    ai=$((${#push_raw[@]} - $# - 1))
    case "$a" in
      -- | --end-of-options)
        # 以降はオプションとして解釈しない
        while (($#)); do
          a="$1"
          shift
          ai=$((${#push_raw[@]} - $# - 1))
          push_positional+=("$a")
          push_pos_idx+=("$ai")
        done
        break ;;
      -o) shift ;; # -o <値>。まとめ書きは下の走査で扱う
      -d) delete=1 ;;
      -n) push_dry_run=1 ;;
      --*)
        opt="${a:2}" neg=0 joined=0 val=""
        [[ "$opt" == no-* ]] && { neg=1; opt="${opt#no-}"; }
        [[ "$opt" == *=* ]] && { joined=1; val="${opt#*=}"; opt="${opt%%=*}"; }
        if push_longopt "$opt" dry-run 2; then
          if ((neg)); then push_dry_run=0; else push_dry_run=1; fi
        elif push_longopt "$opt" delete 2; then
          if ((neg)); then delete=0; else delete=1; fi
        elif push_longopt "$opt" all 2 || push_longopt "$opt" branches 1; then
          # pin のときは旗を外し、dry-run が解決したブランチの refspec に展開する
          if ((neg)); then push_fallback=0; push_expand_idx=(); else push_fallback=1; push_expand_idx+=("$ai"); fi
        elif push_longopt "$opt" mirror 1 || push_longopt "$opt" prune 3; then
          # ブランチ以外の ref や削除も送る形は、送るブランチを pin できない
          if ((neg)); then push_fallback=0; push_no_pin=0; else push_fallback=1; push_no_pin=1; fi
        elif push_longopt "$opt" tags 2; then
          if ((neg)); then push_fallback=0; else push_fallback=1; fi
        elif push_longopt "$opt" repo 3; then
          # --repo は値を取る（=<値> の連結でなければ次の引数）。値を読み飛ばさないと
          # 直後の --no-dry-run や -n を旗と取り違えて dry-run の判定が食い違う。
          # 否定形（--no-repo）は値を取らず fallback も立てない
          if ((neg)); then push_fallback=0
          else
            push_fallback=1
            push_repo_opt=1
            if ((joined)); then push_repo_value="$val"; else push_repo_value="${1:-}"; shift; fi
          fi
        elif push_longopt "$opt" recurse-submodules 4; then
          # --recurse-submodules=only はサブモジュールだけを送り、親リポジトリの ref を
          # 更新しないため resign を呼ばない。後に書いた指定が勝ち、否定形は解除する
          submod_seen=1
          if ((neg)); then submod_only=0
          else
            ((joined)) || { val="${1:-}"; shift; }
            if [[ "$val" == only ]]; then submod_only=1; else submod_only=0; fi
          fi
        elif ((neg || joined)); then
          : # --no-* の否定と =<値> の連結は残りの引数を取らない
        elif push_longopt "$opt" push-option 2 || push_longopt "$opt" receive-pack 4 ||
          push_longopt "$opt" exec 1; then
          shift # 値を別の引数で取る
        fi
        ;;
      -[!-]*)
        # まとめ書きの短いオプションを 1 文字ずつ見る（-fn の dry-run、-fd の削除）。
        # -o は残り（無ければ次の引数）を値に取るため、そこで走査を止める。
        for ((i = 1; i < ${#a}; i++)); do
          case "${a:i:1}" in
            n) push_dry_run=1 ;;
            d) delete=1 ;;
            o) ((i == ${#a} - 1)) && shift || :; break ;;
          esac
        done
        ;;
      -*) ;;
      *)
        push_positional+=("$a")
        push_pos_idx+=("$ai")
        ;;
    esac
  done
  # オプションでの指定がなければ設定を見る。Git は push.recurseSubmodules と submodule.recurse を
  # 読み、後に読んだ設定を使うため、両方のキーを設定ファイルの順序で見て最後のものを採用する。
  # submodule.recurse は真偽値で only を取り得ない。only（サブモジュールだけを送る）は親リポジトリの
  # ref を更新しないため resign を呼ばない。
  # GIT_CONFIG は照会の子プロセスから除く: git config はこの変数があればそのファイルだけを読むが、
  # git push は変数を見ずに通常の設定を読むため、そのままでは判定が push の実態と食い違う。
  # GIT_CONFIG_PARAMETERS / GIT_CONFIG_GLOBAL / GIT_CONFIG_SYSTEM / GIT_CONFIG_NOSYSTEM は push でも
  # 同じように効くため残す
  ((!submod_seen)) && [[ "$(env -u GIT_CONFIG git config --get-regexp '^(push\.recursesubmodules|submodule\.recurse)$' 2>/dev/null | tail -n 1)" == "push.recursesubmodules only" ]] && submod_only=1
  ((delete || submod_only)) && { push_fallback=0; push_no_gate=1; return 0; }
  ((push_fallback)) && return 0
  if ((${#push_positional[@]} < 2)); then
    push_fallback=1
    return 0
  fi
  push_remote="${push_positional[0]}"
  for spec in "${push_positional[@]:1}"; do
    spec="${spec#+}"
    if [[ "$spec" == *'*'* ]]; then
      # glob refspec は Git が展開する ref をこちらで列挙して pin できない
      push_fallback=1
      push_no_pin=1
      continue
    fi
    if [[ "$spec" == *:* ]]; then
      [[ -n "${spec%%:*}" ]] || continue # :dst は削除
      src="${spec%%:*}"
      dst="${spec#*:}"
    else
      src="$spec"
      dst="$spec"
    fi
    if [[ "$dst" == HEAD ]]; then
      dst="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
      [[ -n "$dst" ]] || { push_fallback=1; continue; }
    fi
    # 名前空間を先に判定する（refs/heads/ を除いてから refs/* を見ると refs/heads/refs/topic が外れる）。
    if [[ "$dst" == refs/* && "$dst" != refs/heads/* ]]; then
      continue # タグなど、ブランチ以外
    fi
    dst="${dst#refs/heads/}"
    seen=0
    for b in ${push_branches[@]+"${push_branches[@]}"}; do [[ "$b" != "$dst" ]] || seen=1; done
    ((seen)) || { push_branches+=("$dst"); push_srcs+=("$src"); }
  done
  return 0
}

# repo_of_github_url <URL>: URL が github.com のリポジトリなら <owner>/<repo> を出す。違えば 1。
repo_of_github_url() {
  local u="${1%.git}"
  [[ "$u" =~ github\.com[:/]([^/]+)/([^/]+)$ ]] || return 1
  printf '%s/%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

# push_remote_name: リモートの指定（位置引数・--repo）が無い push が使うリモート名を出す。
# Git と同じ順で remote.pushDefault → branch.<今のブランチ>.remote → origin を見て、
# 実在すればその名を出す。解けなければ 1。
push_remote_name() {
  local rname cur
  rname="$(env -u GIT_CONFIG git config --get remote.pushDefault 2>/dev/null || true)"
  if [[ -z "$rname" ]]; then
    cur="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
    [[ -n "$cur" ]] && rname="$(env -u GIT_CONFIG git config --get "branch.$cur.remote" 2>/dev/null || true)"
  fi
  [[ -z "$rname" ]] && rname="origin"
  git remote get-url "$rname" >/dev/null 2>&1 || return 1
  printf '%s\n' "$rname"
}

# push_remote_spec: push 先の指定（--repo の値、または位置引数の先頭）。無ければ空。
push_remote_spec() {
  if ((push_repo_opt)); then
    printf '%s' "$push_repo_value"
  elif ((${#push_positional[@]} >= 1)); then
    printf '%s' "${push_positional[0]}"
  fi
}

# push_dest_repo <リモート名または URL> <dry-run の To 行の URL>: push 先の GitHub
# リポジトリを <owner>/<repo> で出す（例外の照会に使う）。リモート名なら
# remote.<名>.pushurl / .url の設定値を見る（url.*.insteadOf で書き換わる前の値。
# 輸送先は変わっても同じリポジトリを指す）。解けなければ 1（fail-closed）。
push_dest_repo() {
  local spec="$1" to_url="$2" url="" rname
  if [[ -n "$spec" ]]; then
    url="$(env -u GIT_CONFIG git config --get "remote.$spec.pushurl" 2>/dev/null ||
      env -u GIT_CONFIG git config --get "remote.$spec.url" 2>/dev/null || true)"
    [[ -z "$url" ]] && url="$spec" # リモート名でなければ URL そのもの
  else
    rname="$(push_remote_name || true)"
    [[ -n "$rname" ]] &&
      url="$(env -u GIT_CONFIG git config --get "remote.$rname.pushurl" 2>/dev/null ||
        env -u GIT_CONFIG git config --get "remote.$rname.url" 2>/dev/null || true)"
    [[ -z "$url" ]] && url="$to_url"
  fi
  [[ -n "$url" ]] || return 1
  repo_of_github_url "$url"
}

# pr_size_exception_ok <push 先のブランチ名> <owner>/<repo>: pr-size 上限超えの例外を確かめる（#642）。
# push 先リポジトリの開いた PR のうち、head のリポジトリとブランチが push 先と一致し、
# pr-size-exception ラベルを持つものが閉じる Issue（closingIssuesReferences）に、作成者が hatai で
# 本文の行頭が <!-- pr-size-exception --> のコメントがあれば 0（review-pr の手順 2 と同じ条件）。
# head リポジトリは、同名ブランチを持つフォークの PR の承認を使わないため必ず照合する。
# Issue は GitHub が返すリポジトリ付きの参照（url、無ければ repository + number）で取得し、
# 別リポジトリの同番号 Issue の承認を使わない。それ以外（PR 無し・ラベル無し・コメント無し・
# 作成者が hatai でない）は 1。GitHub への問い合わせが失敗しても 1（fail-closed）。
pr_size_exception_ok() {
  local dst="$1" repo="$2" prs refs ref issue_json found
  prs="$(run_gh pr list --repo "$repo" --head "$dst" --state open \
    --json number,labels,headRefName,headRepository,headRepositoryOwner,closingIssuesReferences)" || return 1
  refs="$(jq -r --arg repo "${repo,,}" --arg dst "$dst" '
    [.[] | select(.headRefName == $dst)
        | select((.headRepository.nameWithOwner //
            "\(.headRepositoryOwner.login // "")/\(.headRepository.name // "")")
          | ascii_downcase == $repo)
        | select([.labels[].name] | any(. == "pr-size-exception"))
        | .closingIssuesReferences[]
        | if .url then .url
          elif .repository.nameWithOwner then "\(.repository.nameWithOwner)#\(.number)"
          else empty end] | unique | .[]' <<<"$prs")" || return 1
  [[ -n "$refs" ]] || return 1
  while IFS= read -r ref; do
    if [[ "$ref" == *'#'* ]]; then
      issue_json="$(run_gh issue view "${ref#*#}" --repo "${ref%#*}" --json comments)" || return 1
    else
      issue_json="$(run_gh issue view "$ref" --json comments)" || return 1
    fi
    found="$(jq '[.comments[] | select(.author.login == "hatai"
        and (.body | startswith("<!-- pr-size-exception -->")))] | length' <<<"$issue_json")" || return 1
    ((found > 0)) && return 0
  done <<<"$refs"
  return 1
}

# pin_push_argv <dry-run の To 行の URL>: pr_size_gate が検査したブランチ更新について、
# 実 push の引数を組み立て直して push_argv に入れる。ブランチの更新は <sha>:<dst> に pin し、
# 検査した sha と送る sha を一致させる。タグ・削除・最新のままの refspec は元の形のまま残す。
# リモートは、位置引数の先頭、--repo、解決したリモート名、dry-run の接続先 URL の順で使う。
pin_push_argv() {
  local url="$1" remote_tok="" pi j tok plus t d2 ndst covered ref_i=0 pos_i=0 k skip e
  local -a new_refs=() gate_used=()
  local rs=1
  ((push_repo_opt)) && rs=0 # --repo があるとき位置引数はすべて refspec
  # 位置引数の refspec を、dry-run が解決した更新と dst で対応付けて <sha>:<dst> に pin する。
  # 対応する更新が無い refspec（タグ・削除・最新のまま・拒否されるもの）は元の形のまま残す。
  for ((pi = rs; pi < ${#push_positional[@]}; pi++)); do
    tok="${push_positional[pi]}"
    plus=""
    t="${tok#+}"
    [[ "$tok" == +* ]] && plus="+"
    if [[ "$t" == *:* ]]; then d2="${t#*:}"; else d2="$t"; fi
    [[ "$d2" == HEAD ]] && d2="refs/heads/$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
    case "$d2" in
      refs/*) ndst="$d2" ;;
      "") ndst="" ;;
      *) ndst="refs/heads/$d2" ;;
    esac
    covered=0
    for j in "${!gate_dsts[@]}"; do
      [[ -n "${gate_used[j]:-}" || "${gate_dsts[j]}" != "$ndst" ]] && continue
      new_refs+=("${plus}${gate_sha[$ndst]}:$ndst")
      gate_used[j]=1
      covered=1
      break
    done
    ((covered)) || new_refs+=("$tok")
  done
  # 位置引数でカバーされないブランチ更新（refspec 省略・--all/--branches）を pin して足す
  for j in "${!gate_dsts[@]}"; do
    [[ -n "${gate_used[j]:-}" ]] && continue
    new_refs+=("${gate_sha[${gate_dsts[j]}]}:${gate_dsts[j]}")
  done
  if ((!push_repo_opt)); then
    if ((${#push_positional[@]} >= 1)); then
      remote_tok="${push_positional[0]}"
    else
      remote_tok="$(push_remote_name || true)"
      [[ -z "$remote_tok" ]] && remote_tok="$url"
      if [[ -z "$remote_tok" ]]; then
        echo "agent-gh: push を止めました: push 先のリモートを特定できません" >&2
        exit 6
      fi
    fi
  fi
  # 元の引数を位置情報どおりに並べ直す: --all/--branches は省き、位置引数は pin した refspec に置き換える
  push_argv=()
  for k in "${!push_raw[@]}"; do
    skip=0
    for e in ${push_expand_idx[@]+"${push_expand_idx[@]}"}; do [[ "$k" != "$e" ]] || skip=1; done
    ((skip)) && continue
    if ((pos_i < ${#push_pos_idx[@]})) && [[ "${push_pos_idx[pos_i]}" == "$k" ]]; then
      if ((pos_i == 0 && !push_repo_opt)); then
        push_argv+=("$remote_tok") # 位置引数の先頭はリモート
      else
        push_argv+=("${new_refs[ref_i]}")
        ref_i=$((ref_i + 1))
      fi
      pos_i=$((pos_i + 1))
      continue
    fi
    push_argv+=("${push_raw[k]}")
  done
  # refspec の無い形（refspec 省略・リモートだけ）はリモートを足してから pin した refspec を足す
  ((!push_repo_opt && ${#push_positional[@]} == 0)) && push_argv+=("$remote_tok")
  for (( ; ref_i < ${#new_refs[@]}; ref_i++)); do
    push_argv+=("${new_refs[ref_i]}")
  done
}

# pr_size_gate <git push の引数（push より後）...>: dev 役の git push の前に、Git が実際に
# 更新するブランチを `git push --dry-run --porcelain` で解決し、送る sha ごとに pr-size を測る。
# 上限（追加 800 行・削除 2000 行）を超えて例外が認められていなければ push せずに止める（#642）。
# - 検査するのは dry-run の出力で refs/heads/ への更新（` `・`+`・`*`）だけ。タグ・削除・
#   最新のまま・拒否される更新は対象外。タグとブランチの区別は出力中の ref の名前空間で行い、
#   ローカルのタグの有無には依存しない
# - 数えるのは Git が送る sha そのもの（解決した src を rev-parse で sha に pin してから測り、
#   実 push の refspec も pin_push_argv で <sha>:<dst> に組み替える。測定と push の間にブランチが
#   動いても、測った sha が送られる）
# - base は push 元のローカルブランチの branch.<名前>.gh-merge-base があれば origin/<その値>、無ければ origin/main
# - 止めるときは stderr に追加・削除の行数・使った base・例外の条件を出し、終了コード 6
pr_size_gate() {
  push_argv=()
  gate_srcs=()
  gate_dsts=()
  local pr_size out line flag refs src dst url="" repo i sha local_branch mb base mrc mout counts
  pr_size="$(cd "$(dirname "$0")" && pwd)/pr-size.sh"
  # dry-run は失敗しても出力だけ読む。更新を解決できない push（upstream 無し・接続失敗・
  # refspec の誤り）は実 push も同じ理由で失敗しブランチは更新されないため、そのまま回す。
  out="$(GH_TOKEN="$token" git "${git_cfg[@]}" push --dry-run --porcelain "$@" 2>/dev/null)" || true
  while IFS= read -r line; do
    case "$line" in
      "To "*) url="${line#To }"; continue ;;
      Done | "Everything up-to-date" | "") continue ;;
    esac
    # 更新行は <旗 1 文字><TAB><src>:<dst><TAB><要約>
    if ((${#line} < 3)) || [[ "${line:1:1}" != $'\t' || "$line" != *$'\t'*:*$'\t'* ]]; then
      echo "agent-gh: push を止めました: git push --dry-run の出力を判定できません（$line）" >&2
      exit 6
    fi
    flag="${line:0:1}"
    refs="${line#*$'\t'}"
    refs="${refs%%$'\t'*}"
    src="${refs%%:*}"
    dst="${refs#*:}"
    # Git が更新する ref の名前空間でブランチか区別する（ローカルのタグの有無には依存しない）
    [[ "$dst" == refs/heads/* ]] || continue
    case "$flag" in
      ' '|'+'|'*') ;; # fast-forward・強制・新規 = 送られる更新
      =|!|-) continue ;; # 最新のまま・拒否・削除 = 送られない
      *)
        echo "agent-gh: push を止めました: git push --dry-run の旗 '$flag' を判定できません" >&2
        exit 6 ;;
    esac
    gate_srcs+=("$src")
    gate_dsts+=("$dst")
  done <<<"$out"
  ((${#gate_dsts[@]} == 0)) && return 0
  if ((push_no_pin)); then
    echo "agent-gh: push を止めました: --mirror・--prune・glob refspec の形では Git が送るブランチを pin して検査できません。ブランチを refspec で明示して push してください" >&2
    exit 6
  fi
  local -A gate_sha=()
  for i in "${!gate_dsts[@]}"; do
    dst="${gate_dsts[i]}"
    src="${gate_srcs[i]}"
    # Git が送る sha を先に pin してから測る（測った sha と実際に送る sha を一致させる）
    sha="$(git rev-parse --verify --quiet "$src^{commit}" 2>/dev/null || true)"
    if [[ -z "$sha" ]]; then
      echo "agent-gh: push を止めました: $dst へ push する $src を解決できません" >&2
      exit 6
    fi
    gate_sha[$dst]="$sha"
    # push 元のローカルブランチ: HEAD は今のブランチ、refs/heads/X は X
    case "$src" in
      HEAD) local_branch="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)" ;;
      refs/heads/*) local_branch="${src#refs/heads/}" ;;
      *) local_branch="$src" ;;
    esac
    # GIT_CONFIG は除く: 判定は push が読む通常の設定と同じもので行う（push_targets と同じ理由）。
    mb="$(env -u GIT_CONFIG git config --get "branch.$local_branch.gh-merge-base" 2>/dev/null || true)"
    base="origin/${mb:-main}"
    mrc=0
    mout="$(bash "$pr_size" --base "$base" --head "$sha" 2>&1)" || mrc=$?
    ((mrc == 0)) && continue
    if ((mrc != 1)); then
      echo "agent-gh: push を止めました: $dst へ push する $src の差分を測れません（base: $base）" >&2
      printf '%s\n' "$mout" >&2
      exit 6
    fi
    repo="$(push_dest_repo "$(push_remote_spec)" "$url" || true)"
    if [[ -n "$repo" ]] && pr_size_exception_ok "${dst#refs/heads/}" "$repo"; then
      continue
    fi
    counts="$(sed -n 's/^pr-size: \(+[^（]*\)（.*$/\1/p' <<<"$mout" | head -n 1)"
    echo "agent-gh: push を止めました: $dst への push の差分が上限を超えています（${counts:-測定不能}、base: $base、上限は追加 800 行・削除 2000 行）" >&2
    echo "agent-gh: 例外で通すには、push 先ブランチの開いた PR に pr-size-exception ラベルがあり、その PR が閉じる Issue に hatai の、行頭が <!-- pr-size-exception --> のコメントが必要です（例外を認めるのは指揮役だけです）" >&2
    exit 6
  done
  # 全ブランチの検査を通った。実 push の refspec を <sha>:<dst> に pin する
  pin_push_argv "$url"
  return 0
}

if [[ "${1:-}" == "git" ]]; then
  shift
  # origin が SSH（git@github.com:）だと credential helper は使われず、hatai の SSH 鍵で認証される。
  # GitHub への URL を HTTPS に書き換え、GH_TOKEN の名義で認証させる。
  # commit.gpgsign=false: 環境の署名設定（hatai の鍵）が App 名義のコミットに混ざるのを防ぐ。
  # 署名は push 後に agent-gh-resign が GitHub API で付け直す（GitHub App の Verified 署名）。
  git_cfg=("${git_identity[@]}" -c commit.gpgsign=false)
  for kind in insteadOf pushInsteadOf; do
    git_cfg+=(-c "url.https://github.com/.$kind=git@github.com:" -c "url.https://github.com/.$kind=ssh://git@github.com/")
  done
  git_cfg+=(-c credential.helper= -c 'credential.helper=!gh auth git-credential')

  if [[ "${1:-}" == "push" ]]; then
    push_targets "${@:2}"
    # dev 役の push では、push する前に Git が実際に送るブランチ更新を dry-run で解決し、
    # 送る sha の差分を測る（#642）。上限を超えて例外が認められていなければ push しない。
    # 試行（--dry-run）・削除・サブモジュールだけの push と review 役の push は対象外。
    if [[ "$role" == dev ]] && ((!push_dry_run && !push_no_gate)); then
      pr_size_gate "${@:2}"
      # 検査を通った push の refspec は <sha>:<dst> に pin してから実行する
      ((${#push_argv[@]} > 0)) && set -- push "${push_argv[@]}"
    fi
  fi

  if [[ "${1:-}" == "push" && -z "${PELWAY_AGENT_SKIP_RESIGN:-}" ]]; then
    rc=0
    GH_TOKEN="$token" git "${git_cfg[@]}" "$@" || rc=$?
    if ((rc == 0)); then
      resign="$(cd "$(dirname "$0")" && pwd)/agent-gh-resign"
      resign_rc=0
      if ((push_dry_run)); then
        : # --dry-run / -n の試行では何も push されていないため、署名の付け直しは呼ばない
      else
        if ((push_fallback)); then
          GH_TOKEN="$token" bash "$resign" || resign_rc=$?
        fi
        for t in ${push_branches[@]+"${push_branches[@]}"}; do
          GH_TOKEN="$token" bash "$resign" "$push_remote" "$t" || resign_rc=$?
        done
      fi
      if ((resign_rc != 0)); then
        echo "agent-gh: 署名付きコミットへの付け替えに失敗しました（push 自体は成功）。再度 push すると再試行されます。スキップは PELWAY_AGENT_SKIP_RESIGN=1" >&2
        exit 4
      fi
    fi
    exit "$rc"
  fi
  # exec しない（EXIT trap で一時 GH_CONFIG_DIR を消すため）。終了コードは git のものを返す。
  GH_TOKEN="$token" git "${git_cfg[@]}" "$@"
  exit $?
fi

# exec しない（EXIT trap で一時 GH_CONFIG_DIR を消すため）。終了コードは gh のものを返す。
rc=0
run_gh "$@" || rc=$?
exit "$rc"
