#!/usr/bin/env bash
# 指揮役の立て直し（恒久交代。docs/agents/conductor-context.md の「恒久交代」）を始める。
# hatai がホストの端末で、必ず本体 checkout の版を実行する（worktree の版は sandbox の中から
# 書き換えられる。下の worktree の確かめは、書き換えられていない版を誤って worktree から起動したときの止め具）。
#
#   scripts/conductor-rebuild --from <旧指揮役のスレッド ID> --to <新指揮役のスレッド ID>
#
# 新しい指揮役はこのスクリプトでは立てない。t3 thread start には権限（runtimeMode）を指定する
# フラグが無く、プロジェクトの既定の full-access で立ってしまうため、先に MCP の
# t3_thread_launch で旧指揮役と同じ権限（full-access 以外）と main から作った worktree を
# 指定して立て、そのスレッド ID を --to に渡す（手順は docs/agents/conductor-context.md の
# 「恒久交代」。--to が無いときはその手順を出して止まる）。
# 1. 新しい指揮役の権限（runtimeMode）が旧指揮役と同じで、full-access でなく、worktree で
#    動いていることを確かめる。合わなければ、旧指揮役には何も送らず、登録も変えずに止まる。
#    worktree のパスは立てた直後にまだ空のことがあるため、入るまで上限付きで読み直して待つ
#    （下の環境変数）。上限を超えても空なら、準備中か worktree なしで立てられたかの判定が
#    thread show からは取れないため、T3 の画面で確かめる案内を出して止まる
# 2. 旧指揮役に決まった停止の文を送り、終わるまで待つ（t3 thread send --wait）
# 3. 新しい指揮役に引き継ぎの指示を送る（t3 thread send）
# 4. 起こしの宛先を新しい指揮役に替える（インストールした ~/.local/bin/pelway-agent-watch --register）
#
# 環境変数（試験が小さい値に上書きする）:
#   PELWAY_REBUILD_WT_WAIT           worktree のパスが入るまで待つ上限（秒。既定 120）
#   PELWAY_REBUILD_WT_INTERVAL       読み直しの間隔（秒。既定 2）
#   PELWAY_REBUILD_SHOW_RETRIES      読み取りの thread show が "database is locked" で
#                                    失敗したときのやり直しの上限（回。既定 3）
#   PELWAY_REBUILD_SHOW_RETRY_SLEEP  そのやり直しの間（秒。既定 1）
# やり直すのは読み取りの thread show だけ。thread send は二重送信を防ぐためやり直さない。
# 旧指揮役の settle と巡回の scheduled task の作り直しは、新しい指揮役が引き継ぎの確認の後に行う
# （t3 CLI には settle が無い。権限は確認の完了で移る）。
set -euo pipefail

usage() { sed -n '6p' "$0" | sed 's/^# *//' >&2; exit 2; }
valid_id() { [[ "$1" != -* && "$1" =~ ^[A-Za-z0-9:_.%-]{1,256}$ ]]; }
die() { echo "conductor-rebuild: $*" >&2; exit 1; }

from="" to=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from) from="${2-}"; shift 2 || usage ;;
    --to) to="${2-}"; shift 2 || usage ;;
    --provider|--model|--effort) usage ;;  # 立てる処理が無くなったため受け付けない
    *) usage ;;
  esac
done
[[ -n "$from" ]] || usage
valid_id "$from" || die "--from is not a thread id"
[[ -z "$to" ]] || valid_id "$to" || die "--to is not a thread id"
[[ "$to" != "$from" ]] || die "--to must differ from --from"

# 本体 checkout（共有の git dir の親）。新しい指揮役は、ここから main の worktree を作って動く。
common="$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir)"
gitdir="$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-dir)"
project="$(dirname "$common")"
# worktree からの起動は止める（誤って起動したときの止め具。試験だけ PELWAY_REBUILD_ALLOW_WORKTREE=1 で外す）
if [[ "$gitdir" != "$common" && "${PELWAY_REBUILD_ALLOW_WORKTREE:-}" != 1 ]]; then
  die "run it from the main checkout ($project), not from a worktree"
fi

# --to は必須。このスクリプトは新しい指揮役を立てない。立てるのは MCP の t3_thread_launch で、
# 旧指揮役と同じ runtimeMode（full-access 以外）と worktree（baseRef main）を指定して立ててから、
# そのスレッド ID を --to に渡して実行し直す。
if [[ -z "$to" ]]; then
  echo "conductor-rebuild: --to is required; this script does not create the new conductor." >&2
  echo "conductor-rebuild: launch the new conductor with MCP t3_thread_launch (docs/agents/conductor-context.md の「恒久交代」):" >&2
  echo "conductor-rebuild:   \"runtimeMode\": \"<旧指揮役と同じ値。full-access 以外>\"" >&2
  echo "conductor-rebuild:   \"workspaceStrategy\": {\"type\": \"worktree\", \"baseRef\": \"main\"}" >&2
  echo "conductor-rebuild: then run: $0 --from '$from' --to '<新指揮役のスレッド ID>'" >&2
  exit 2
fi

# 宛先の登録に使う、インストールした見張り役（mise run agent-watch-install で入れる）
WATCH="$HOME/.local/bin/pelway-agent-watch"
[[ -x "$WATCH" ]] || die "$WATCH not found (run mise run agent-watch-install)"

# 動いている T3 サーバーと同じ実行ファイルを使う（PATH の t3 は ServerOwnsDatabaseError で拒まれることがある）。
# 受け入れるのは $HOME/.t3/wsl-runtime/ の下の t3 で、.. を含まず、自分の所有の通常ファイルのもの
# （agent-watch の find_server_t3 と同じ確かめ）。T3_BIN で差し替えられる（テスト用）。
T3="${T3_BIN:-}"
if [[ -z "$T3" ]]; then
  T3="$(command -v t3 || true)"
  for exe in /proc/[0-9]*/exe; do
    link="$(readlink "$exe" 2>/dev/null || true)"
    case "$link" in
      *..*) continue ;;
      "$HOME"/.t3/wsl-runtime/*/t3)
        if [[ -f "$link" && ! -L "$link" && -O "$link" ]]; then T3="$link"; break; fi ;;
    esac
  done
fi
[[ -n "$T3" ]] || die "t3 not found"

# 待ちとやり直しの上限・間隔（冒頭のコメント参照。試験は小さい値に上書きする）
WT_WAIT="${PELWAY_REBUILD_WT_WAIT:-120}"
WT_INTERVAL="${PELWAY_REBUILD_WT_INTERVAL:-2}"
SHOW_RETRIES="${PELWAY_REBUILD_SHOW_RETRIES:-3}"
SHOW_RETRY_SLEEP="${PELWAY_REBUILD_SHOW_RETRY_SLEEP:-1}"

# 最後の thread show の生の出力（"database is locked" の判定に stderr が要るためファイルに受ける）
SHOW_OUT="$(mktemp)"; SHOW_ERR="$(mktemp)"
trap 'rm -f "$SHOW_OUT" "$SHOW_ERR"' EXIT

# 経過時間はロケールに左右されない単調時計で測る（EPOCHREALTIME は壁時計で、
# 小数点がコンマのロケールでは整数化に使えないため）
now_us() { /usr/bin/python3 -I -c 'import time; print(int(time.monotonic() * 1000000))'; }

# sleep <a 秒>・<b マイクロ秒> の小さい方だけ待つ（b が 0 以下なら待たない）。
# 読み直しの間隔とやり直しの待ちを残り時間内に収めるために使う
sleep_min_us() {
  sleep "$(awk -v a="$1" -v b="$2" 'BEGIN{u=b/1000000; if (u < 0) u = 0; print (a < u) ? a : u}')"
}

# show <id> — runtimeMode と worktree のパス（無ければ -）を 1 行で返す。
# t3 コマンドが "database is locked" で失敗したときだけ、間を空けて最大 $SHOW_RETRIES 回
# やり直す。それ以外の失敗（lock 以外のエラー、t3 が成功したが JSON にならない出力、
# 期限での打ち切り）ではやり直さない。SHOW_DEADLINE_US に期限（マイクロ秒）があれば、
# 読み取りの呼び出し自体を残り時間で打ち切り（初回も再試行も）、やり直しの待ちも残り
# 時間に収め、期限を超える読み直しは始めない（各呼び出しは必ず 1 回読む）
show() {
  local tries=0 deadline="${SHOW_DEADLINE_US:-}" rc
  while :; do
    if (( tries > 0 )) && [[ -n "$deadline" ]] && (( $(now_us) >= deadline )); then
      return 1
    fi
    : >"$SHOW_OUT"; : >"$SHOW_ERR"
    rc=0
    if [[ -n "$deadline" ]]; then
      timeout "$(awk -v u="$(( deadline - $(now_us) ))" 'BEGIN{s=u/1000000; print (s>0)?s:0}')" \
        "$T3" thread show "$1" --json >"$SHOW_OUT" 2>"$SHOW_ERR" || rc=$?
    else
      "$T3" thread show "$1" --json >"$SHOW_OUT" 2>"$SHOW_ERR" || rc=$?
    fi
    if (( rc == 0 )); then
      /usr/bin/python3 -I -c '
import json, sys
t = json.load(sys.stdin); t = t.get("thread", t)
print(t.get("runtimeMode") or "-", t.get("worktreePath") or "-")' <"$SHOW_OUT"
      return
    fi
    tries=$((tries + 1))
    if (( tries > SHOW_RETRIES )) || ! grep -q "database is locked" "$SHOW_ERR" "$SHOW_OUT"; then
      return 1
    fi
    if [[ -n "$deadline" ]]; then
      sleep_min_us "$SHOW_RETRY_SLEEP" $(( deadline - $(now_us) ))
    else
      sleep "$SHOW_RETRY_SLEEP"
    fi
  done
}
show_err() { local e; e="$(sed -n '1p' "$SHOW_ERR")"; [[ -n "$e" ]] && printf ': %s' "$e"; }

read -r old_mode _ < <(show "$from") || die "cannot read the old conductor$(show_err)"
[[ "$old_mode" != - ]] || die "cannot read the old conductor's runtimeMode"
[[ "$old_mode" != full-access ]] || die "the old conductor runs in full-access; fix it before rebuilding"

# 1. 権限を確かめる。worktree のパスは立てた直後にまだ空のことがあるため、入るまで
#    上限付きで読み直して待つ（待っている間、どのスレッドにも thread send は呼ばない）。
#    待ちそのものも上限に収める：期限を過ぎたら次の読み取りを始めず（1 回目は必ず読む）、
#    読み直しの間隔と show 内のやり直しの待ちは残り時間で切り詰め、読み取りの呼び出し
#    自体も残り時間で打ち切る（show の SHOW_DEADLINE_US。初回も再試行も）
start_us=$(now_us)
end_us=$(awk -v s="$start_us" -v w="$WT_WAIT" 'BEGIN{printf "%d", s + w * 1000000}')
# aborted は起動環境の同名変数で権限の確かめが飛ばないよう、ここで初期化する
new_mode=-; new_wt=-; first=1; aborted=
SHOW_DEADLINE_US=$end_us
while :; do
  (( first )) || (( $(now_us) < end_us )) || break
  first=0
  read -r new_mode new_wt < <(show "$to") \
    || { if (( $(now_us) >= end_us )); then aborted=1; new_mode=-; new_wt=-; break; fi
         die "cannot read the new conductor $to (check it in T3)$(show_err). Nothing was sent to the old conductor and the registration is unchanged"; }
  # 期限を超えて返った読み取りは worktree の有無の判定に使わない（呼び出しは残り時間で
  # 打ち切るが、期限の直前に返り切ることがある）
  (( $(now_us) > end_us )) && { new_wt=-; break; }
  [[ "$new_wt" != - ]] && break
  sleep_min_us "$WT_INTERVAL" $(( end_us - $(now_us) ))
done
unset SHOW_DEADLINE_US
echo "conductor-rebuild: new conductor $to runtimeMode=$new_mode worktree=$new_wt" >&2
# 期限で読み取りを打ち切ったときは権限は読めていないため、権限の確かめは省いて時間切れを報告する。
# 正常に読み取れた経路では権限の確かめは必ず通る
if [[ -z "$aborted" ]]; then
  if [[ "$new_mode" == - ]]; then
    echo "conductor-rebuild: cannot read the new conductor $to's runtimeMode." >&2
    echo "conductor-rebuild: nothing was sent to the old conductor and the registration is unchanged." >&2
    echo "conductor-rebuild: launch a replacement with MCP t3_thread_launch (runtimeMode '$old_mode', workspaceStrategy worktree baseRef main), then run: $0 --from '$from' --to '<新指揮役のスレッド ID>'" >&2
    exit 3
  fi
  if [[ "$new_mode" != "$old_mode" || "$new_mode" == full-access ]]; then
    echo "conductor-rebuild: the new conductor $to runs in '$new_mode', but the old one runs in '$old_mode'." >&2
    echo "conductor-rebuild: nothing was sent to the old conductor and the registration is unchanged." >&2
    echo "conductor-rebuild: launch a replacement with MCP t3_thread_launch (runtimeMode '$old_mode', workspaceStrategy worktree baseRef main), then run: $0 --from '$from' --to '<新指揮役のスレッド ID>'" >&2
    exit 3
  fi
fi
if [[ "$new_wt" == - ]]; then
  waited=$(( ($(now_us) - start_us) / 1000000 ))
  echo "conductor-rebuild: the new conductor $to still has no worktree after waiting ${waited}s (limit ${WT_WAIT}s); worktree がまだ無い（準備中か、worktree なしで立てられた）." >&2
  echo "conductor-rebuild: check the new conductor's worktree in the T3 window; if it was launched without a worktree, launch a replacement as below. Nothing was sent to the old conductor and the registration is unchanged." >&2
  echo "conductor-rebuild: launch a replacement with MCP t3_thread_launch (runtimeMode '$old_mode', workspaceStrategy worktree baseRef main), then run: $0 --from '$from' --to '<新指揮役のスレッド ID>'" >&2
  exit 1
fi

# 2. 旧指揮役を止める
STOP="恒久交代を始める（docs/agents/conductor-context.md の「恒久交代」）。案件を進める操作（スレッドの起動・指示、マージ、ラベル、コメント、ステータス変更）を止め、引き継ぎの記録を指揮役の作業ログと patrol-state.json に書き出して、このターンを終える。以後は操作しない。scheduled task や起こしで起きても、巡回も patrol-state.json の書き込みもせずにターンを終える。"
printf '%s' "$STOP" | "$T3" thread send --wait "$from" - >/dev/null \
  || die "failed to stop the old conductor; the new conductor $to is waiting and the registration is unchanged"

# 3. 新しい指揮役に引き継ぎを指示する
START="あなたは新しい指揮役。skill command-team と docs/agents/conductor-context.md の「恒久交代」に従い、旧指揮役（スレッド $from）から引き継ぐ。引き継ぎ確認（GitHub の実状態、patrol-state、巡回記録、実行中スレッドの照合）を済ませて操作権限を受け取ったら、旧指揮役のスレッドを t3_thread_organize で settle し、巡回の scheduled task を作り直す（runbook の「指揮役の定期巡回（スケジュール起床）」）。確認が完了しない場合は権限を受け取らず、hatai に知らせる。"
printf '%s' "$START" | "$T3" thread send "$to" - >/dev/null \
  || die "the old conductor is stopped, but sending the handover to $to failed; send it by hand. The registration is unchanged"

# 4. 宛先を替える
"$WATCH" --register "$to" \
  || die "the new conductor $to has the handover, but registering it failed; run: $WATCH --register '$to'"
echo "conductor-rebuild: new conductor $to (the old conductor is settled by the new one after the handover check)"
