#!/usr/bin/env bash
# mise run verify の検査を始める前に、前回の成功の印を消す（#807）。
# 同じ木で再実行が失敗したとき、古い印で push が通らないようにする。
set -euo pipefail

fail() {
  echo "agent-verify-invalidate: $1" >&2
  exit 1
}

git_dir="$(git rev-parse --git-dir 2>/dev/null)" || fail "gitdir を解決できません"
git_dir="$(CDPATH='' cd -- "$git_dir" 2>/dev/null && pwd -P)" || fail "gitdir を絶対パスに解決できません"
rm -f -- "$git_dir/pelway-verify-tree" || fail "前回の印を消せません"
