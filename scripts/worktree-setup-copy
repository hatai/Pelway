#!/usr/bin/env python3
# worktree-setup から呼ばれるコピー手続き（Issue #804）。
# 検査・存在確認が済んだあとの、設定ファイル 1 件のコピーだけを行う。
#
# 引数: <dst-dir-fd> <src-dir-fd> <basename>
#   両側とも呼び出し元が開いて引き継いだディレクトリの fd。パスは一切使わず、
#   dir_fd 基点の操作だけで済ませる（パスが並行して差し替わっても、読み書き
#   するのは開いた実体の中だけ）
#
# 手順:
#   1. コピー元を dir_fd 基点で O_NOFOLLOW|O_NONBLOCK に開く（symlink を
#      たどらず、FIFO に変わっても書き手を待たない）。開いた fd が通常
#      ファイルのときだけ読む
#   2. 一時名は乱数つきで O_EXCL|O_NOFOLLOW に作る（予測不能・自分専有・
#      symlink は作らない）
#   3. 公開は、書き終えた fd を /proc/self/fd 経由でリンクする（一時名や
#      最終名が並行して差し替わっても、公開されるのは自分が書いた inode
#      だけで、既存名は上書きしない）
#   4. 後始末は、一時名の参照先が自分が作った実体（dev:ino 一致）のときだけ
#      unlink する（別の処理が置いたファイルは消さない）。後始末に失敗
#      した場合は成功として返さない
#
# 終了コード: 0 写した / 4 コピー元が無い / 5 コピー元を開けない（権限等） /
#   6 コピー元が通常ファイルでない（symlink・FIFO・ディレクトリ等） /
#   7 一時名を作れない / 8 最終名が既に現れた / 9 読み書き・リンクの失敗 /
#   10 後始末の失敗（一時ファイルが残りうる）
import errno
import os
import stat
import sys

ddir, sdir, name = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
if os.path.basename(name) != name:
    sys.exit(2)

try:
    sfd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=sdir)
except FileNotFoundError:
    sys.exit(4)
except OSError as e:
    sys.exit(6 if e.errno == errno.ELOOP else 5)
if not stat.S_ISREG(os.fstat(sfd).st_mode):
    sys.exit(6)

tmp = f"{name}.worktree-setup.{os.getpid()}.{os.urandom(4).hex()}.tmp"
try:
    tfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                  0o644, dir_fd=ddir)
except OSError:
    sys.exit(7)

rc = 0
try:
    try:
        while True:
            chunk = os.read(sfd, 1 << 20)
            if not chunk:
                break
            view = memoryview(chunk)
            while view:
                view = view[os.write(tfd, view):]
    except OSError:
        rc = 9
    if rc == 0:
        try:
            os.link(f"/proc/self/fd/{tfd}", name,
                    dst_dir_fd=ddir, follow_symlinks=True)
        except FileExistsError:
            rc = 8
        except OSError:
            rc = 9
finally:
    try:
        os.close(sfd)
    except OSError:
        pass
    # 一時名の参照先が自分の作った実体か確かめてから消す。一致しなければ
    # 別の処理のものなので触らない（自分の一時名は既に外されている）
    try:
        st = os.stat(tmp, dir_fd=ddir, follow_symlinks=False)
        tf = os.fstat(tfd)
        if st.st_ino == tf.st_ino and st.st_dev == tf.st_dev:
            os.unlink(tmp, dir_fd=ddir)
    except FileNotFoundError:
        pass
    except OSError:
        if rc == 0:
            rc = 10
    try:
        os.close(tfd)
    except OSError:
        pass

sys.exit(rc)
