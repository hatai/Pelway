# Rust / mr boxington（target は mbx の管理対象への symlink になる）
/target

# CI のビルド成果物置き場（.github/workflows/verify.yml の CARGO_TARGET_DIR）。
# mbx の symlink 先が変わってもキャッシュが壊れないよう、target とは別にする。
/target-ci

# QA-GDPR-13 走査試験の退避サンドボックス（target/ が worktree 外へ解決される
# symlink の環境で使う。中身はコミットしない）
.gdpr-13-sandbox/

# fnox 個人用オーバーライド（秘密値を含みうるためコミットしない）
fnox.local.toml
.fnox.local.toml
.config/fnox.local.toml

# mise / hk 個人用オーバーライド
mise.local.toml
.mise.local.toml
hk.local.pkl

# devin のプロジェクトローカル上書き（公式の運用で gitignore 対象）
.devin/config.local.json
.devin/mcp_config.local.json

# 環境変数ファイルの誤コミット防止（秘密は fnox で管理）
# .env.example はテンプレートとしてコミットを許可する
.env
.env.*
!.env.example

# OS・エディタの一時ファイル
.DS_Store

# 日本語全文検索ベンチマーク（Issue #93）の作業ディレクトリ（計測ログ・
# 結果。再生成は scripts/ja-fts-bench/bench.sh で行う）
scripts/ja-fts-bench/work/

# pgBackRest 検証（Issue #101）の作業ディレクトリ（設定・チェック結果・
# 削除記録。再生成は scripts/pgbackrest-verify/verify.sh で行う）
scripts/pgbackrest-verify/work/

# カバレッジ計測（cargo llvm-cov --lcov）のローカル検証生成物（#157。
# .github/workflows/verify.yml の coverage ジョブと同じ引数で出力する）
lcov.info
